---
import type { RunRecord } from '@drewstone/agent-record/record'
import AgentRecordView, { type EventIdMap } from './AgentRecordView'
import '@tangle-network/sandbox-ui/styles'
import type { BehaviorReport } from '@tangle-network/sandbox-ui/record'
interface Props { records: RunRecord[]; idmap: EventIdMap; behaviors?: readonly BehaviorReport[] }
const { records, idmap, behaviors = [] } = Astro.props
---
<style is:global>
  .record-view-switch { display: flex; gap: .4rem; margin: 0 0 .75rem; }
  .record-view-switch button { font: inherit; padding: .3rem .8rem; border: 1px solid var(--border); border-radius: 6px; background: transparent; color: inherit; cursor: pointer; }
  .record-view-switch button[aria-pressed='true'] { background: var(--fg); color: var(--bg); }
</style>
<AgentRecordView records={records} idmap={idmap} behaviors={behaviors} client:load />
<noscript><p>The interactive viewer requires JavaScript. <a href={`/research/records/${records[0].runId}.json`}>Download the retained record.</a></p></noscript>
