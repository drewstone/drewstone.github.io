---
import type { RunRecord } from '@drewstone/agent-record/record'
import AgentRecordView, { type EventIdMap } from './AgentRecordView'
import '@drewstone/agent-record/styles.css'
interface Props { records: RunRecord[]; idmap: EventIdMap; behaviors?: unknown[] }
const { records, idmap, behaviors = [] } = Astro.props
---
<style is:global>
  .record-view-switch { display: flex; gap: .4rem; margin: 0 0 .75rem; }
  .record-view-switch button { font: inherit; padding: .3rem .8rem; border: 1px solid var(--border); border-radius: 6px; background: transparent; color: inherit; cursor: pointer; }
  .record-view-switch button[aria-pressed='true'] { background: var(--fg); color: var(--bg); }
  /* The viewer reads every surface from these host tokens (agent-record styles.css), so both site themes carry through,
     the provenance graph's cards and panels included. */
  .research-agent-record {
    --ar-background: var(--bg);
    --ar-surface: var(--bg);
    --ar-panel: var(--bg);
    --ar-raised: var(--bg-alt);
    --ar-surface-alt: var(--bg-alt);
    --ar-code-background: var(--bg-sink);
    --ar-line: var(--border);
    --ar-line-strong: var(--border-strong);
    --ar-muted: var(--fg-muted);
    --ar-faint: var(--fg-faint);
    --ar-title: var(--fg);
    --ar-foreground: var(--fg);
    --ar-font: var(--font-body);
    --ar-mono: var(--font-mono);

    --ar-accent: var(--accent);
    /* Charts library tokens mapped to the site theme (dark default). */
    --chart-canvas: var(--ar-background);
    --chart-ink: var(--ar-foreground);
    --chart-ink-muted: var(--ar-muted);
    --chart-muted: var(--ar-muted);
    --chart-grid: var(--ar-line);
    --chart-rule: var(--ar-line);
    --chart-shade: color-mix(in srgb, var(--ar-foreground) 4%, transparent);
    --chart-accent: var(--ar-accent);
    --chart-pass: #4ade80;
    --chart-breach: #f87171;
    --chart-outcome-ok: #4ade80;
    --chart-outcome-lost: #f87171;
    --chart-outcome-neutral: var(--ar-muted);
    --chart-outcome-oom: #fb923c;
    --chart-outcome-quota: #fb923c;
    --chart-outcome-rate-limit: #fbbf24;
    --chart-outcome-refused: var(--ar-muted);
    --chart-outcome-other: var(--ar-muted);
    --chart-tier-a: var(--ar-accent);
    --chart-tier-b: var(--ar-muted);
    --chart-tier-c: var(--ar-subtle);
    --chart-tier-s: var(--ar-foreground);
    --chart-checker-0: var(--ar-accent);
    --chart-checker-1: #4ade80;
    --chart-checker-2: #fbbf24;
    --chart-checker-3: #f87171;
  }


  /* Unified typography: the charts library's clean 12-13px sans everywhere,
     not the viewer's 15px mono for structural labels. */
  .research-agent-record {
    --ar-text-s: 13px;
    --ar-text-m: 15px;
    --ar-text-l: 22px;
  }
  .research-agent-record svg .axis-label,
  .research-agent-record svg .lane-label {
    font: 11px var(--font-sans, ui-sans-serif, system-ui);
    letter-spacing: 0.01em;
  }
  .research-agent-record svg[data-tokens] .axis-label {
    font-size: 10px;
  }
  /* All top-level dropdown summaries: same compact style. */
  .research-agent-record details > summary {
    font: 500 12px/1.4 var(--font-sans, ui-sans-serif, system-ui);
    color: var(--ar-muted);
    cursor: pointer;
    list-style: none;
    padding: 6px 0;
  }
  .research-agent-record details > summary::marker,
  .research-agent-record details > summary::-webkit-details-marker {
    display: none;
  }
  .research-agent-record details > summary::before {
    content: '▸';
    display: inline-block;
    margin-right: 6px;
    font-size: 10px;
    transition: transform 0.15s;
    color: var(--ar-subtle);
  }
  .research-agent-record details[open] > summary::before {
    transform: rotate(90deg);
  }
  .research-agent-record .topology-tree > summary,
  .research-agent-record .activity-replay > summary,
  .research-agent-record .assignment > summary,
  .research-agent-record .coverage > summary {
    font: 500 12px/1.4 var(--font-sans, ui-sans-serif, system-ui);
    padding: 6px 0.85rem;
    border-bottom: 1px solid var(--ar-line);
  }

  /* Align topology and timeline to the same horizontal grid. */
  .research-agent-record .topology-tree,
  .research-agent-record .activity-replay {
    margin-left: 0;
    margin-right: 0;
    padding-left: 0.85rem;
    padding-right: 0.85rem;
  }
  .research-agent-record .topology-tree > summary,
  .research-agent-record .activity-replay > summary {
    padding-left: 0;
    padding-right: 0;
  }
  .research-agent-record .topology-tree .tgc-timeline-view {
    margin: 0;
  }
  .research-agent-record .timeline-scroll {
    margin-left: 0;
    margin-right: 0;
  }

  /* Timeline heading controls: tighter. */
  .research-agent-record .timeline-heading {
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding: 4px 0;
    font-size: 12px;
  }
  .research-agent-record .timeline-heading label {
    font-size: 11px;
    color: var(--ar-muted);
  }

  /* Dense terminal-style tool call feed: no boxed cards, 22px rows, no per-item borders. */
  .research-agent-record .chat-message {
    padding: 0.25rem 0.5rem 0.25rem 1.8rem !important;
  }
  .research-agent-record .chat-message + .chat-message {
    border-top: none !important;
  }
  .research-agent-record .chat-message::before {
    left: 0.85rem;
    top: 1.2rem;
    bottom: -0.2rem;
  }
  .research-agent-record .message-heading {
    margin: 0 0 0.1rem;
    gap: 0.35rem;
  }
  .research-agent-record .message-mark {
    left: 0.35rem;
    top: 0.3rem;
  }
  .research-agent-record .tool-stack {
    margin-top: 0.15rem !important;
    gap: 0 !important;
  }
  .research-agent-record .tool-execution {
    border: none;
    border-radius: 3px;
    background: transparent;
  }
  .research-agent-record .tool-execution > summary {
    min-height: 22px !important;
    padding: 0.12rem 0.4rem !important;
    gap: 0.35rem;
  }
  .research-agent-record .tool-execution > summary:hover {
    background: color-mix(in srgb, var(--ar-surface-alt, #eee) 60%, transparent);
  }
  .research-agent-record .tool-execution[open] > summary {
    background: color-mix(in srgb, var(--ar-surface-alt, #eee) 30%, transparent);
    border-bottom: none;
  }
  .research-agent-record .tool-turn {
    padding-top: 0.05rem;
    padding-bottom: 0.05rem;
  }
  .research-agent-record .hollow-group {
    border: none;
    border-radius: 3px;
  }
  .research-agent-record .hollow-group > summary {
    min-height: 22px !important;
    padding: 0.1rem 0.4rem;
  }
  .research-agent-record .lifecycle-note {
    padding: 3px 8px;
    border-bottom: none;
  }
</style>
<AgentRecordView records={records} idmap={idmap} behaviors={behaviors} client:load />
<noscript><p>The interactive viewer requires JavaScript. <a href={`/research/records/${records[0].runId}.json`}>Download the retained record.</a></p></noscript>

<script>
  // Audit fixes for the record viewer — applied after React renders.
  // These are label and readability corrections the package should carry
  // natively; until the dependency chain allows it, patch here.
  {
    const fix = () => {
      // 1) "Assignment" → "What this agent did" (these are role summaries, not assignments)
      document.querySelectorAll('.research-agent-record details summary').forEach((s) => {
        if (s.textContent.trim() === 'Assignment') s.textContent = 'What this agent did';
      });
      // 2) Hide raw source JSON behind a "Provenance" label
      document.querySelectorAll('.research-agent-record details.assignment pre').forEach((pre) => {
        if (!pre.previousElementSibling || pre.previousElementSibling.tagName !== 'SUMMARY') {
          const wrap = document.createElement('details');
          wrap.className = 'assignment-source';
          const label = document.createElement('summary');
          label.textContent = 'Provenance';
          wrap.appendChild(label);
          pre.parentNode.insertBefore(wrap, pre);
          wrap.appendChild(pre);
        }
      });
      // 3) Omit "Cost: Not recorded"
      document.querySelectorAll('.research-agent-record [data-coverage] p').forEach((p) => {
        if (p.textContent.trim() === 'Cost: Not recorded') p.remove();
      });
    };
    // Run after initial render and after any React re-render
    const observer = new MutationObserver(() => requestAnimationFrame(fix));
    const mount = document.getElementById('agent-record');
    if (mount) observer.observe(mount, { childList: true, subtree: true });
    fix();
  }
</script>
