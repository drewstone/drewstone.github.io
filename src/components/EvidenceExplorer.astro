---
import type { EvidenceRecord } from '../lib/research-evidence'
interface Props { records: EvidenceRecord[] }
const { records } = Astro.props
const first = records[0]
const json = JSON.stringify(records).replace(/</g, '\\u003c')
---
<div class="evidence-explorer">
  <p class="explanation">Each mark is a retained event.
    Select a mark to inspect its attribution and source.
    Lines connect recorded parent and child agents; native sessions with unresolved joins stay separate.</p>
  <section class="assignment">
    <h3>The research assignment</h3>
    <p data-objective>{first.assignment.objective}</p>
    <details><summary>Supplied knowledge, completion criteria &amp; constraints</summary>
      <dl data-assignment></dl>
      <p class="assignment-note">This is a curated public summary of the retained input, with its source hash.
        It is separate from the raw prompt.</p>
    </details>
  </section>
  <div class="controls">
    <label>Pursuit <select data-run>{records.map((r,i)=><option value={i}>{r.title}</option>)}</select></label>
    <label>Show <select data-category><option value="all">All activity</option><option value="findings">Recorded findings</option><option value="coordination">Coordination</option><option value="computation">Computation</option><option value="verification">Verification</option><option value="literature">Literature</option><option value="infrastructure">Infrastructure</option><option value="other">Other records</option></select></label>
    <label>Find <input data-search type="search" placeholder="Agent, model, event…" /></label>
  </div>
  <p data-summary class="record-summary">{first.coverage.runtimeNodes} Runtime nodes · {first.coverage.nativeFiles} native session files · capture incomplete</p>
  <div class="legend" aria-label="Activity colors">
    {['coordination','computation','verification','literature','infrastructure','other'].map(c=><span><i class={c}></i>{c}</span>)}
  </div>
  <div class="timeline-scroll" tabindex="0" aria-label="Agent timeline; scroll horizontally on small screens">
    <svg data-timeline role="group" tabindex="0" aria-label="Recorded agent activity. Use left and right arrows to select events."></svg>
  </div>
  <div class="navigation">
    <label class="moment-label">Jump to <select data-moment aria-label="Jump to a pivotal recorded moment"></select></label>
    <button data-prev type="button">Previous event</button>
    <button data-next type="button">Next event</button>
    <span data-position></span>
    <a data-download href={`/research/records/${first.runId}.json`} download>Download event record</a>
  </div>
  <div class="inspection-grid">
    <section class="inspector" aria-label="Selected event">
      <h3 data-event-title aria-live="polite" aria-atomic="true">Select an event</h3>
      <p data-event-meta></p>
      <pre data-event-detail></pre>
      <details class="source"><summary>Source &amp; attribution</summary><pre data-event-source></pre></details>
    </section>
    <section class="token-plot">
      <h3>Recorded token trajectory</h3>
      <svg data-tokens role="img" aria-label="Cumulative provider token counters over time"></svg>
      <p data-token-caption></p>
    </section>
  </div>
  <p data-empty hidden>No retained events match this selection.</p>
  <details class="coverage"><summary>What this record preserves</summary><div data-coverage></div></details>
  <noscript><p>The interactive view requires JavaScript.
    <a href={`/research/records/${first.runId}.json`}>The event record</a> remains available as JSON.</p><ul>{first.events.slice(0,12).map(e=><li>{e.at}: {e.label}</li>)}</ul></noscript>
  <script type="application/json" data-evidence set:html={json} />
</div>
<script>
  import type { EvidenceRecord } from '../lib/research-evidence'
  type Event = EvidenceRecord['events'][number]
  const NS = 'http://www.w3.org/2000/svg'
  for (const root of document.querySelectorAll<HTMLElement>('.evidence-explorer')) {
    const element = <T extends Element>(s: string) => {
      const el = root.querySelector<T>(s)
      if (!el) throw new Error(`Missing evidence control ${s}`)
      return el
    }
    const records: EvidenceRecord[] = JSON.parse(element('[data-evidence]').textContent || '[]')
    const runSelect = element<HTMLSelectElement>('[data-run]')
    const filter = element<HTMLSelectElement>('[data-category]')
    const search = element<HTMLInputElement>('[data-search]')
    const svg = element<SVGSVGElement>('[data-timeline]')
    const tokenSvg = element<SVGSVGElement>('[data-tokens]')
    const moment = element<HTMLSelectElement>('[data-moment]')
    let record = records[0]
    let visible: Event[] = []
    let selected = ''
    const ms = (s: string) => new Date(s).valueOf()
    const formatCount = (n: number) => new Intl.NumberFormat('en-US', {notation:'compact',maximumFractionDigits:1}).format(n)
    const text = (s: string, value: string) => { element(s).textContent = value }
    const shape = (parent: SVGElement, name: string, attrs: Record<string,string|number>, body?:string) => {
      const el = document.createElementNS(NS, name)
      for (const [k,v] of Object.entries(attrs)) el.setAttribute(k,String(v))
      if (body) el.textContent=body
      parent.append(el)
      return el
    }
    const inspect = (event: Event) => {
      selected=event.id
      for (const mark of svg.querySelectorAll('[data-id]')) mark.classList.toggle('selected',mark.getAttribute('data-id')===selected)
      const node=record.nodes.find(n=>n.id===event.node)
      text('[data-event-title]',event.label)
      text('[data-event-meta]',`${event.at} · ${node?.label ?? event.node} · ${node?.model ?? 'model unknown'}${node?.modelSource ? ` (${node.modelSource})` : ''}`)
      text('[data-event-detail]',JSON.stringify(event.detail,null,2))
      text('[data-event-source]',JSON.stringify({runId:record.runId,nodeId:event.node,nativeSessionId:node?.nativeSessionId ?? null,runtimeJoin:node?.kind==='native'?'unresolved':node?.kind==='finding'?'run-level finding; individual author unresolved':'recorded Runtime node',...event.source},null,2))
      text('[data-position]',`${visible.findIndex(e=>e.id===selected)+1} / ${visible.length}`)
      const url = new URL(location.href)
      url.searchParams.set('pursuit',record.runId)
      url.searchParams.set('event',event.id)
      history.replaceState(null,'',url)
    }
    function render() {
      const query=search.value.trim().toLowerCase()
      visible=record.events.filter(e=>(filter.value==='all'||e.category===filter.value||(filter.value==='findings'&&e.kind==='finding-record')) && (!query||JSON.stringify({event:e.label,node:record.nodes.find(n=>n.id===e.node),detail:e.detail}).toLowerCase().includes(query)))
      const nodes=record.nodes
      const start=Math.min(...record.events.map(e=>ms(e.at)))
      const end=Math.max(...record.events.map(e=>ms(e.at)))
      const span=Math.max(end-start,1)
      const width=1040, left=190, right=24, step=39, top=45
      const height=nodes.length*step+top+35
      const x=(at:string)=>left+(ms(at)-start)/span*(width-left-right)
      const y=(id:string)=>top+nodes.findIndex(n=>n.id===id)*step
      svg.replaceChildren()
      svg.setAttribute('viewBox',`0 0 ${width} ${height}`)
      svg.style.minWidth='760px'
      for(let i=0;i<=4;i++) {
        const px=left+i/4*(width-left-right)
        shape(svg,'line',{x1:px,x2:px,y1:top-15,y2:height-20,class:'grid-line'})
        shape(svg,'text',{x:px,y:21,'text-anchor':'middle',class:'axis-label'},`${Math.round(span*i/4/60000)} min`)
      }
      nodes.forEach(n=>{
        const yy=y(n.id)
        const label=n.label==='worker'?`worker · ${n.id.split(':').at(-1)}`:n.label
        const lane=shape(svg,'text',{x:0,y:yy+4,class:'lane-label'},label.length>29?label.slice(0,27)+'…':label)
        shape(lane,'title',{},`${label}\n${n.id}`)
        shape(svg,'line',{x1:left,x2:width-right,y1:yy,y2:yy,class:n.kind==='native'?'native-line':'lane-line'})
        if(n.parent&&nodes.some(p=>p.id===n.parent)&&n.start) shape(svg,'path',{d:`M ${x(n.start)} ${y(n.parent)} L ${x(n.start)} ${yy}`,class:'parent-link'})
      })
      for(const event of visible) {
        const mark=shape(svg,event.kind==='spawned'?'circle':'rect',event.kind==='spawned'?{cx:x(event.at),cy:y(event.node),r:5,class:`event ${event.category}`}:{x:x(event.at)-2,y:y(event.node)-7,width:4,height:14,rx:1,class:`event ${event.category}`})
        mark.setAttribute('data-id',event.id)
        // Arrow navigation exposes dense records without hundreds of tiny tab stops.
        mark.setAttribute('role','button')
        mark.setAttribute('aria-label',`${event.label}, ${event.at}`)
        shape(mark,'title',{},`${event.label}\n${event.at}`)
        mark.addEventListener('click',()=>inspect(event))
      }
      moment.replaceChildren(new Option('Choose a moment…',''))
      for (const event of visible.filter(e=>['spawned','settled','finding-record'].includes(e.kind))) {
        const label=record.nodes.find(n=>n.id===event.node)?.label??event.node
        moment.append(new Option(`${event.at.slice(11,19)} · ${label} · ${event.label}`,event.id))
      }
      text('[data-summary]',`${record.coverage.runtimeNodes} Runtime nodes · ${record.coverage.nativeFiles} native files · ${visible.length} of ${record.events.length} events · capture incomplete`)
      text('[data-objective]',record.assignment.objective)
      const assignment=element('[data-assignment]');assignment.replaceChildren()
      for(const [name,value] of [['Supplied knowledge',record.assignment.suppliedKnowledge],['Completion criteria',record.assignment.deliverables],['Constraints',record.assignment.constraints],['Input source',record.assignment.source?`${record.assignment.source.path} · SHA-256 ${record.assignment.source.sha256}`:'Complete original input unavailable']]) {
        const dt=document.createElement('dt'), dd=document.createElement('dd');dt.textContent=name;dd.textContent=value;assignment.append(dt,dd)
      }
      element<HTMLAnchorElement>('[data-download]').href=`/research/records/${record.runId}.json`
      element<HTMLElement>('[data-empty]').hidden=visible.length>0
      const coverage=element('[data-coverage]');coverage.replaceChildren()
      for(const value of [record.coverage.publicContent,record.coverage.categoryMethod,record.coverage.cost,`${record.coverage.nativeRuntimeJoins} native-to-Runtime joins established. Native session and finding lanes are not additional proven agents. Configuration declarations and failed requests do not prove a served model.`,`${record.sources.length} source files are identified by SHA-256. Their original private bytes are retained separately; hash agreement proves file identity, not completeness.`]) {
        const p=document.createElement('p');p.textContent=value;coverage.append(p)
      }
      tokenSvg.replaceChildren();tokenSvg.setAttribute('viewBox','0 0 440 200')
      const measured=record.events.filter(e=>e.detail.usage && typeof e.detail.usage==='object')
      let total=0
      const points=measured.map(e=>{
        const usage=e.detail.usage as Record<string,number>
        total+=usage.totalTokens ?? (usage.input ?? 0)+(usage.output ?? 0)+(usage.cacheRead ?? 0)+(usage.cacheWrite ?? 0)
        return {at:e.at,total}
      })
      shape(tokenSvg,'line',{x1:40,x2:425,y1:170,y2:170,class:'grid-line'})
      shape(tokenSvg,'text',{x:40,y:193,class:'axis-label'},'Start')
      shape(tokenSvg,'text',{x:425,y:193,'text-anchor':'end',class:'axis-label'},`${Math.round(span/60000)} min`)
      if(points.length&&total>0) {
        const xx=(at:string)=>40+(ms(at)-start)/span*385
        const yy=(n:number)=>170-n/total*145
        const d=`M 40 170 `+points.map(p=>`L ${xx(p.at)} ${yy(p.total)}`).join(' ')
        shape(tokenSvg,'path',{d,class:'token-line'})
        shape(tokenSvg,'text',{x:40,y:15,class:'axis-label'},`${formatCount(total)} tokens`)
        text('[data-token-caption]',`${points.length} recorded usage entries. Counters include repeated context and cached input; this is not unique text or billed cost. Uncaptured sessions are omitted.`)
      } else {
        shape(tokenSvg,'text',{x:220,y:90,'text-anchor':'middle',class:'axis-label'},'No token trajectory retained')
        text('[data-token-caption]','Missing token counters remain unknown. Failed children are not counted as zero-cost research.')
      }
      const event=visible.find(e=>e.id===selected)??visible.find(e=>e.kind==='finding-record')??visible[0]
      if(event)inspect(event)
      else {text('[data-event-title]','No matching event');text('[data-event-meta]','');text('[data-event-detail]','');text('[data-event-source]','');text('[data-position]','0 / 0')}
      element<HTMLButtonElement>('[data-prev]').disabled=visible.length===0
      element<HTMLButtonElement>('[data-next]').disabled=visible.length===0
    }
    const params=new URL(location.href).searchParams
    const index=records.findIndex(r=>r.runId===params.get('pursuit'))
    if(index>=0){runSelect.value=String(index);record=records[index]}
    selected=params.get('event')??''
    runSelect.addEventListener('change',()=>{record=records[Number(runSelect.value)];selected='';render()})
    filter.addEventListener('change',render)
    search.addEventListener('input',render)
    const move=(delta:number)=>{if(visible.length)inspect(visible[(visible.findIndex(e=>e.id===selected)+delta+visible.length)%visible.length])}
    element('[data-prev]').addEventListener('click',()=>move(-1))
    element('[data-next]').addEventListener('click',()=>move(1))
    moment.addEventListener('change',()=>{const e=visible.find(e=>e.id===moment.value);if(e)inspect(e)})
    svg.addEventListener('keydown',event=>{if(event.key==='ArrowLeft'||event.key==='ArrowRight'){event.preventDefault();move(event.key==='ArrowLeft'?-1:1)}})
    render()
  }
</script>
<style>
  .explanation { max-width: 42rem; color: var(--fg-muted); font-size: .95rem; }
  .assignment { max-width: 43rem; margin: 1.5rem 0; }
  .assignment p { font-size: .9rem; }
  .assignment-note { color: var(--fg-muted); }
  .assignment :global(dt) { font-size: .8rem; font-weight: bold; margin-top: .8rem; }
  .assignment :global(dd) { font-size: .85rem; color: var(--fg-muted); overflow-wrap: anywhere; }
  .controls { display: flex; flex-wrap: wrap; gap: .8rem 1rem; margin: 1.5rem 0; }
  label { display: grid; gap: .3rem; font: .68rem var(--font-mono); flex: 1; min-width: 8rem; }
  select, input, button { color: var(--fg); background: var(--bg); border: 1px solid var(--border-strong); border-radius: 2px; padding: .55rem; font: .7rem var(--font-mono); min-width: 0; max-width: 100%; }
  button { cursor: pointer; }
  button:disabled { opacity: .5; cursor: default; }
  :is(select,input,button):focus-visible { outline: 2px solid var(--c-info); outline-offset: 3px; }
  .record-summary, .navigation { font: .66rem var(--font-mono); color: var(--fg-muted); }
  .legend { display: flex; flex-wrap: wrap; gap: .5rem 1.1rem; font: .62rem var(--font-mono); margin: 1rem 0; }
  .legend span { display: flex; align-items: center; gap: .35rem; }
  .legend i { width: .5rem; height: .5rem; display: block; }
  .coordination { background: var(--c-action); }
  .computation { background: var(--c-info); }
  .verification { background: var(--c-ok); }
  .literature { background: var(--c-run); }
  .infrastructure { background: var(--c-fail); }
  .other { background: var(--fg-faint); }
  .timeline-scroll { overflow: auto; border-block: 1px solid var(--border); padding: .75rem 0; }
  svg { width: 100%; display: block; }
  svg :global(.axis-label), svg :global(.lane-label) { fill: var(--fg-muted); font: 11px var(--font-mono); }
  svg :global(.grid-line), svg :global(.lane-line) { stroke: var(--border); stroke-width: 1; }
  svg :global(.native-line) { stroke: var(--border); stroke-dasharray: 3 4; }
  svg :global(.parent-link) { stroke: var(--fg-faint); stroke-width: 1; fill: none; }
  svg :global(.event) { cursor: pointer; }
  svg :global(.event:hover), svg :global(.selected) { stroke: var(--fg); stroke-width: 3; }
  svg :global(.coordination) { fill: var(--c-action); }
  svg :global(.computation) { fill: var(--c-info); }
  svg :global(.verification) { fill: var(--c-ok); }
  svg :global(.literature) { fill: var(--c-run); }
  svg :global(.infrastructure) { fill: var(--c-fail); }
  svg :global(.other) { fill: var(--fg-faint); }
  svg :global(.token-line) { stroke: var(--c-info); fill: none; stroke-width: 2; }
  .navigation { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; padding: 1rem 0; }
  .navigation a { margin-left: auto; }
  .moment-label { flex-basis: 100%; max-width: 100%; }
  .inspection-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: .5rem; }
  .inspection-grid section { min-width: 0; }
  h3 { margin: .5rem 0 .8rem; font-size: 1rem; font-style: normal; font-weight: 700; overflow-wrap: anywhere; }
  .inspector p, .token-plot p { font-size: .75rem; color: var(--fg-muted); overflow-wrap: anywhere; }
  pre { margin: 0; padding: .8rem; background: var(--bg-alt); font: .65rem/1.6 var(--font-mono); white-space: pre-wrap; overflow-wrap: anywhere; max-height: 13rem; overflow-y: auto; }
  summary { cursor: pointer; font-size: .85rem; }
  details { margin-top: .8rem; }
  .coverage { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border); }
  .coverage :global(p) { font-size: .85rem; max-width: 45rem; margin-top: .75rem; color: var(--fg-muted); }
  @media(max-width:700px) { .inspection-grid { grid-template-columns: 1fr; gap: 1rem; } .navigation a { margin-left: 0; } }
  @media print { .controls, .navigation { display: none; } .timeline-scroll { overflow: visible; } svg { min-width: 0 !important; } }
</style>
