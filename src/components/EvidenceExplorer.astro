---
import type { RunRecord } from '@drewstone/agent-record/record'
import AgentRecordView from './AgentRecordView'
import '@drewstone/agent-record/styles.css'
interface Props { records: RunRecord[] }
const { records } = Astro.props
---
<AgentRecordView records={records} client:load />
<noscript><p>The interactive viewer requires JavaScript. <a href={`/research/records/${records[0].runId}.json`}>Download the retained record.</a></p></noscript>
<style is:global>
  .research-agent-record {
    --ar-background: var(--bg);
    --ar-foreground: var(--fg);
    --ar-font: var(--font-body);
    --ar-mono: var(--font-mono);
  }
</style>
