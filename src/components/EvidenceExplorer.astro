---
import type { RunRecord } from '@drewstone/agent-record/record'
import AgentRecordView, { type EventIdMap } from './AgentRecordView'
import '@tangle-network/sandbox-ui/styles'
import type { BehaviorReport } from '@tangle-network/sandbox-ui/record'
interface Props { records: RunRecord[]; idmap: EventIdMap; behaviors?: readonly BehaviorReport[]; downloads?: Record<string, string> }
const { records, idmap, behaviors = [], downloads = {} } = Astro.props
const download = downloads[records[0].runId] ?? `/research/records/${records[0].runId}.json`
---
<style is:global>
  .record-view-switch { display: flex; gap: .4rem; margin: 0 0 .75rem; }
  .record-view-switch button { font: inherit; padding: .3rem .8rem; border: 1px solid var(--border); border-radius: 6px; background: transparent; color: inherit; cursor: pointer; }
  .record-view-switch button[aria-pressed='true'] { background: var(--fg); color: var(--bg); }
</style>
{/* Hydrated when it comes into view, so a reader of the essay does not load the viewer up front; a link to #agent-record opens it at once. */}
<AgentRecordView records={records} idmap={idmap} behaviors={behaviors} client:visible />
<noscript><p>The interactive viewer requires JavaScript. <a href={download}>Download the retained record.</a></p></noscript>
