---
import type { RunRecord } from '@drewstone/agent-record/record'
import AgentRecordView, { type EventIdMap } from './AgentRecordView'
import '@drewstone/agent-record/styles.css'
interface Props { records: RunRecord[]; idmap: EventIdMap }
const { records, idmap } = Astro.props
---
<style is:global>
  .record-view-switch { display: flex; gap: .4rem; margin: 0 0 .75rem; }
  .record-view-switch button { font: inherit; padding: .3rem .8rem; border: 1px solid var(--line, currentColor); border-radius: 6px; background: transparent; color: inherit; cursor: pointer; }
  .record-view-switch button[aria-pressed='true'] { background: var(--fg); color: var(--bg); }
  .research-agent-record {
    --ar-background: var(--bg);
    --ar-foreground: var(--fg);
    --ar-font: var(--font-body);
    --ar-mono: var(--font-mono);
  }
</style>
<AgentRecordView records={records} idmap={idmap} client:load />
<noscript><p>The interactive viewer requires JavaScript. <a href={`/research/records/${records[0].runId}.json`}>Download the retained record.</a></p></noscript>
