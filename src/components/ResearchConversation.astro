---
import type { EvidenceRecord } from '../lib/research-evidence'
import { toolIcon, toolSvg } from '../lib/chat-icons'
import ChatBlock from './ChatBlock.astro'
interface Props {
  record: EvidenceRecord
}
const { record } = Astro.props
type Event = EvidenceRecord['events'][number]
interface ToolCall {
  id: string
  name: string
  input?: string
  publicationNote?: string | null
}
const nodeById = new Map(record.nodes.map((n) => [n.id, n]))
const canonical = (id: string) => nodeById.get(id)?.runtimeNodeId ?? id
const calls = (event: Event): ToolCall[] => {
  const published = (event.detail.publicToolCalls ?? []) as ToolCall[]
  const byId = new Map(published.map((call) => [call.id, call]))
  return ((event.detail.toolCallIds ?? []) as string[]).map(
    (id) =>
      byId.get(id) ?? {
        id,
        name:
          (event.detail.toolNames as string[] | undefined)?.length === 1
            ? String((event.detail.toolNames as string[])[0])
            : 'Tool call',
      },
  )
}
const key = (node: string, id: string) => `${node}\0${id}`
const results = new Map<string, Event[]>()
const called = new Set(
  record.events.flatMap((e) => calls(e).map((call) => key(e.node, call.id))),
)
for (const e of record.events)
  if (
    e.detail.role === 'toolResult' &&
    typeof e.detail.toolCallId === 'string'
  ) {
    const k = key(e.node, e.detail.toolCallId)
    results.set(k, [...(results.get(k) ?? []), e])
  }
const items = record.events.filter((e) =>
  e.detail.role === 'toolResult'
    ? !called.has(key(e.node, String(e.detail.toolCallId)))
    : e.detail.publicText ||
      e.detail.recordedClaim ||
      e.detail.responseStatus === 'error' ||
      calls(e).length,
)
const actors = [...new Set(items.map((e) => canonical(e.node)))]
const compact = (text: string) => text.replace(/\s+/g, ' ').trim()
const output = (e: Event) =>
  typeof e.detail.publicText === 'string' ? e.detail.publicText : ''
const toolPreview = (call: ToolCall) => {
  if (!call.input) return 'Arguments not published'
  try {
    const args = JSON.parse(call.input)
    return compact(
      String(
        args.command ?? args.path ?? args.query ?? args.task ?? call.input,
      ),
    )
  } catch {
    return compact(call.input)
  }
}
const duration = (call: Event, result?: Event) => {
  if (!result) return null
  const seconds = (Date.parse(result.at) - Date.parse(call.at)) / 1000
  return seconds < 0
    ? null
    : seconds < 1
      ? `${Math.round(seconds * 1000)} ms`
      : `${seconds.toFixed(1)} s`
}
---

{actors.map((actor) => (
  <template data-chat-record={record.runId} data-chat-actor={actor}>
    {items
      .filter((e) => canonical(e.node) === actor)
      .map((e) => {
        const user = e.detail.role === 'user',
          failed = e.detail.responseStatus === 'error',
          finding = Boolean(e.detail.recordedClaim),
          message = output(e) || String(e.detail.recordedClaim ?? ''),
          tools = calls(e)
        const standalone = e.detail.role === 'toolResult'
        return (
          <article
            class:list={[
              'chat-message',
              {
                'assignment-message': user,
                'tool-turn': !message && !failed && tools.length > 0,
                'finding-message': finding,
                'error-message': failed,
              },
            ]}
            data-entry={e.id}
            data-message={e.id}
            data-message-node={e.node}
          >
            {(message || failed || standalone) && (
              <header class="message-heading">
                <span class="message-mark" aria-hidden="true">
                  {user
                    ? '↳'
                    : finding
                      ? '◇'
                      : failed
                        ? '!'
                        : standalone
                          ? '↵'
                          : '✦'}
                </span>
                <strong>
                  {user
                    ? 'Assignment'
                    : finding
                      ? 'Recorded finding'
                      : failed
                        ? 'Request failed'
                        : standalone
                          ? 'Tool result'
                          : 'Agent'}
                </strong>
                <time datetime={e.at}>{e.at.slice(11, 19)}</time>
                <button
                  class="message-source"
                  type="button"
                  data-source-event={e.id}
                  aria-label={`Inspect source of ${e.label}`}
                >
                  Source ↗
                </button>
              </header>
            )}
            {user ? (
              <details class="prompt-body" data-open-key={`prompt:${e.id}`}>
                <summary>
                  <span>
                    {compact(message).slice(0, 210)}
                    {message.length > 210 ? '…' : ''}
                  </span>
                  <span class="prompt-toggle">Full prompt</span>
                </summary>
                <ChatBlock block={{ kind: 'text', content: message }} />
              </details>
            ) : standalone ? (
              <div class="standalone-output">
                <pre>{message||String(e.detail.publicationNote??'No result text was recovered for this event.')}</pre>
              </div>
            ) : message ? (
              <ChatBlock block={{ kind: 'text', content: message }} />
            ) : failed ? (
              <p class="recorded-error">
                The request failed. No assistant response or usage measurement
                was retained.
              </p>
            ) : null}
            {e.detail.publicationNote && (
              <p class="publication-note">{String(e.detail.publicationNote)}</p>
            )}
            {finding && (
              <p class="publication-note">{String(e.detail.assessment)}</p>
            )}
            {tools.length > 0 && (
              <div class="tool-stack">
                {tools.map((call) => {
                  const returned = results.get(key(e.node, call.id)) ?? [],
                    last = returned.at(-1),
                    elapsed = duration(e, last)
                  const status = last
                    ? last.detail.isError === true
                      ? 'error'
                      : 'returned'
                    : 'missing'
                  return (
                    <details
                      class="tool-execution"
                      data-tool-call={call.id}
                      data-open-key={`tool:${e.node}:${call.id}`}
                      data-call-at={e.at}
                      data-return-at={last?.at}
                      data-observed-status={status}
                      data-status={status}
                    >
                      <summary>
                        <span
                          class="execution-icon"
                          set:html={toolSvg(toolIcon(call.name))}
                        />
                        <span class="execution-name">{call.name}</span>
                        <span
                          class="execution-preview"
                          title={toolPreview(call)}
                        >
                          {toolPreview(call)}
                        </span>
                        <span
                          class="execution-time"
                          data-tool-duration
                          title="Observed time from tool call to result"
                        >
                          {elapsed}
                        </span>
                        <span class="execution-status" data-tool-status>
                          {status === 'error'
                            ? 'Error'
                            : status === 'returned'
                              ? 'Returned'
                              : 'No result'}
                        </span>
                      </summary>
                      <div class="execution-detail">
                        <section class="execution-input">
                          <header>
                            <span>Input</span>
                            <button
                              class="message-source"
                              data-source-event={e.id}
                            >
                              Source ↗
                            </button>
                          </header>
                          <pre>{call.input??'Tool arguments are absent from this publication.'}</pre>
                          {call.publicationNote && (
                            <p class="publication-note">
                              {call.publicationNote}
                            </p>
                          )}
                        </section>
                        {returned.map((result) => (
                          <section
                            class="execution-output"
                            data-message={result.id}
                            data-result-at={result.at}
                            data-result-error={String(
                              result.detail.isError === true,
                            )}
                          >
                            <header>
                              <span>
                                {result.detail.isError === true
                                  ? 'Error'
                                  : 'Output'}
                              </span>
                              <time datetime={result.at}>
                                {result.at.slice(11, 19)} UTC
                              </time>
                              <button
                                class="message-source"
                                data-source-event={result.id}
                              >
                                Source ↗
                              </button>
                            </header>
                            <pre>{output(result)||String(result.detail.publicationNote??'The retained result contains no text.')}</pre>
                            {output(result) &&
                              result.detail.publicationNote && (
                                <p class="publication-note">
                                  {String(result.detail.publicationNote)}
                                </p>
                              )}
                          </section>
                        ))}
                        <p
                          class="result-pending"
                          data-result-pending
                          hidden={returned.length > 0}
                        >
                          {returned.length
                            ? 'The result had not returned at the selected time.'
                            : 'No matching result was recovered for this call.'}
                        </p>
                      </div>
                    </details>
                  )
                })}
              </div>
            )}
          </article>
        )
      })}
  </template>
))}
<style>
  .chat-message {
    position: relative;
    padding: 0.65rem 0.85rem 0.65rem 2.5rem;
  }
  .chat-message + .chat-message {
    border-top: 1px solid color-mix(in srgb, var(--border) 55%, transparent);
  }
  .chat-message::before {
    content: '';
    position: absolute;
    left: 1.13rem;
    top: 2rem;
    bottom: -0.7rem;
    width: 1px;
    background: var(--border);
  }
  .chat-message:last-child::before {
    display: none;
  }
  .chat-message.selected {
    background: color-mix(in srgb, var(--c-info-bg) 25%, var(--bg));
  }
  .message-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.35rem;
    font: 12px var(--font-mono);
  }
  .message-heading strong {
    font-weight: 600;
  }
  .message-mark {
    position: absolute;
    left: 0.6rem;
    top: 0.55rem;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    background: var(--bg);
    color: var(--c-action);
    font: 17px var(--font-body);
    z-index: 1;
  }
  .assignment-message .message-mark {
    color: var(--fg-muted);
  }
  .message-heading time {
    font-size: 10px;
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }
  .message-source {
    border: 0;
    background: transparent;
    padding: 0.15rem 0;
    font: 10px var(--font-mono);
    color: var(--fg-muted);
    margin-left: auto;
    white-space: nowrap;
  }
  .message-source:hover {
    color: var(--c-info);
  }
  .chat-message :global(.blk-text) {
    font: 16px/1.45 var(--font-body);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding: 0;
  }
  .prompt-body {
    background: color-mix(in srgb, var(--bg-alt) 45%, var(--bg));
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.55rem 0.65rem;
  }
  .prompt-body > summary {
    display: block;
    padding: 0;
    font: 14px/1.4 var(--font-body);
    color: var(--fg-muted);
  }
  .prompt-body > summary::before {
    display: none;
  }
  .prompt-toggle {
    display: block;
    margin-top: 0.4rem;
    color: var(--fg);
    font: 10px var(--font-mono);
  }
  .prompt-body[open] > summary > span:first-child {
    display: none;
  }
  .prompt-body[open] .prompt-toggle {
    margin: 0 0 0.5rem;
  }
  .tool-turn {
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
  }
  .tool-turn::before {
    top: 0;
  }
  .tool-stack {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.25rem;
  }
  .tool-turn .tool-stack {
    margin-top: 0;
  }
  .tool-execution {
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--bg);
    overflow: hidden;
    min-width: 0;
  }
  .tool-execution > summary {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.36rem 0.5rem;
    font: 11px var(--font-mono);
    min-height: 31px;
  }
  .tool-execution > summary::before {
    display: none;
  }
  .tool-execution > summary::after {
    content: '+';
    font-size: 13px;
    color: var(--fg-faint);
    margin-left: 0.2rem;
  }
  .tool-execution[open] > summary::after {
    content: '−';
  }
  .tool-execution > summary:hover {
    background: var(--bg-alt);
  }
  .tool-execution[open] > summary {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-alt) 45%, var(--bg));
  }
  .execution-icon {
    display: flex;
    color: var(--c-action);
    flex-shrink: 0;
  }
  .execution-name {
    font-weight: 600;
    white-space: nowrap;
    max-width: 12rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .execution-preview {
    flex: 1;
    color: var(--fg-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    min-width: 0;
  }
  .execution-time {
    color: var(--fg-faint);
    font-size: 10px;
    white-space: nowrap;
  }
  .execution-status {
    color: var(--fg-muted);
    font-size: 9px;
    white-space: nowrap;
  }
  [data-status='returned'] .execution-status {
    color: var(--c-ok);
  }
  [data-status='error'] {
    border-color: var(--c-fail-border);
  }
  [data-status='error'] .execution-status {
    color: var(--c-fail);
  }
  .execution-detail {
    padding: 0 0.65rem;
  }
  .execution-detail section {
    padding: 0.5rem 0;
  }
  .execution-detail section + section {
    border-top: 1px solid var(--border);
  }
  .execution-detail header {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font: 10px var(--font-mono);
    color: var(--fg-muted);
    margin-bottom: 0.4rem;
  }
  .execution-detail time {
    color: var(--fg-faint);
    font-size: 9px;
  }
  .execution-detail pre,
  .standalone-output pre {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    overflow: auto;
    max-height: 20rem;
    font: 12px/1.5 var(--font-mono);
    margin: 0;
    padding: 0.6rem;
    background: var(--bg-sink);
    border-radius: 3px;
  }
  .execution-output.selected {
    box-shadow: inset 2px 0 var(--c-info);
    padding-left: 0.5rem;
  }
  .publication-note,
  .result-pending {
    font: 11px/1.4 var(--font-mono);
    color: var(--fg-muted);
    margin: 0.4rem 0 0;
    overflow-wrap: anywhere;
  }
  .result-pending {
    padding: 0.6rem 0;
  }
  .recorded-error {
    font-size: 14px;
    color: var(--c-fail);
    margin: 0;
  }
  .error-message .message-mark {
    color: var(--c-fail);
  }
  .finding-message {
    background: color-mix(in srgb, var(--c-ok-bg) 25%, var(--bg));
  }
  @media (max-width: 600px) {
    .chat-message {
      padding: 0.6rem 0.45rem 0.6rem 1.9rem;
    }
    .chat-message::before {
      left: 0.85rem;
    }
    .message-mark {
      left: 0.3rem;
    }
    .tool-execution > summary {
      display: grid;
      grid-template-columns: 14px minmax(0, 1fr) auto auto 10px;
      column-gap: 0.35rem;
    }
    .execution-preview {
      display: block;
      grid-column: 2 / -1;
      grid-row: 2;
      font-size: 10px;
    }
    .execution-name {
      flex: 1;
      max-width: none;
    }
    .execution-status {
      font-size: 9px;
    }
    .execution-time {
      font-size: 9px;
    }
    .chat-message :global(.blk-text) {
      font-size: 15px;
    }
    .execution-detail {
      padding: 0 0.45rem;
    }
    .execution-detail pre {
      font-size: 11px;
    }
  }
</style>
