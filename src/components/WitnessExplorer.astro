---
import ChoicePicker from './ChoicePicker.astro'
interface Props {
  kind: 'bcww' | 'ghz' | 'lw6' | 'apn'
}
const { kind } = Astro.props
const captions = {
  lw6: 'The plotted rows use retained interval certificates. A finite ladder alone does not prove divergence; the analytic argument below does.',
  apn: 'Exact arithmetic in F₃₂: the reduced polynomial is rebuilt from the 32 table values under the chosen modulus, then its derivative is evaluated at every element. Cells are numbered by their bits in the basis 1, α, …, α⁴.',
  default: 'The interactive calculation uses ordinary floating point. The exact certificate in the text establishes the sign at the stated witness.',
}
const ariaLabels = {
  lw6: 'Certified finite ratio ladder on a logarithmic axis',
  apn: 'Derivative of the reduced polynomial at each of the 32 field elements',
  default: 'Entropy inequality witness calculation',
}
---

<figure class="witness-explorer" data-kind={kind}>
  {kind === 'bcww' && (
    <ChoicePicker
      label="Witness"
      field="witness"
      options={[
        { value: 'corrected', label: 'Corrected five-atom witness' },
        { value: 'invalid', label: 'Invalid original atom set' },
      ]}
    />
  )}
  {kind === 'ghz' && (
    <label>
      GHZ weight{' '}
      <input
        data-mixture
        type="range"
        min="0.02"
        max="0.98"
        step="0.01"
        value="0.75"
      />
      <output data-parameter>0.75</output>
    </label>
  )}
  {kind === 'apn' && (
    <div class="pickers">
      <ChoicePicker
        label="Function"
        field="apn-function"
        options={[
          { value: 'witness', label: '(x + x⁸ + x¹⁶)³' },
          { value: 'cube', label: 'x³, the power map' },
        ]}
      />
      <ChoicePicker
        label="Modulus"
        field="apn-modulus"
        options={[
          { value: '37', label: 'x⁵ + x² + 1' },
          { value: '41', label: 'x⁵ + x³ + 1' },
          { value: '47', label: 'x⁵ + x³ + x² + x + 1' },
          { value: '55', label: 'x⁵ + x⁴ + x² + x + 1' },
          { value: '59', label: 'x⁵ + x⁴ + x³ + x + 1' },
          { value: '61', label: 'x⁵ + x⁴ + x³ + x² + 1' },
        ]}
      />
    </div>
  )}
  {kind === 'lw6' && (
    <label>
      Family parameter L{' '}
      <input data-ladder type="range" min="2" max="16" step="1" value="2" />
      <output data-parameter>2</output>
    </label>
  )}
  <svg
    data-plot
    viewBox="0 0 620 250"
    role="img"
    aria-label={ariaLabels[kind in ariaLabels ? (kind as 'lw6' | 'apn') : 'default']}
  ></svg>
  <p data-value></p>
  <div data-table></div>
  <figcaption>
    {captions[kind in captions ? (kind as 'lw6' | 'apn') : 'default']}
  </figcaption>
  <noscript>
    <p>
      Exploration requires JavaScript. The exact witness and proof remain
      readable in the article.
    </p>
  </noscript>
</figure>
<script>
  import { plotTooltip } from '../lib/plot-tooltip'
  const NS = 'http://www.w3.org/2000/svg'
  const terms: [string, number][] = [
    ['ABD', 1],
    ['ABC', 1],
    ['BCD', 1],
    ['BD', -2],
    ['BC', -2],
    ['CD', 1],
    ['AD', -1],
    ['AC', -1],
    ['AB', -1],
    ['B', 2],
    ['A', 1],
  ]
  const corrected = ['0001', '0010', '0011', '0111', '1000']
  const invalid = ['0000', '0010', '0100', '1000', '1101']
  const entropy = (atoms: string[], weights: number[], parties: string) => {
    const mass = new Map<string, number>()
    const sum = weights.reduce((a, b) => a + b, 0)
    atoms.forEach((s, i) => {
      const key = [...parties].map((c) => s['ABCD'.indexOf(c)]).join('')
      mass.set(key, (mass.get(key) ?? 0) + weights[i] / sum)
    })
    return [...mass.values()].reduce(
      (h, p) => h - (p > 0 ? p * Math.log2(p) : 0),
      0,
    )
  }
  const score = (p: number) =>
    terms.reduce(
      (v, [s, c]) =>
        v +
        c *
          entropy(
            ['0000', '1111', '1010', '1001'],
            [p / 2, p / 2, (1 - p) / 2, (1 - p) / 2],
            s,
          ),
      0,
    )
  for (const root of document.querySelectorAll<HTMLElement>(
    '.witness-explorer',
  )) {
    const tooltip = plotTooltip(root)
    const svg = root.querySelector<SVGSVGElement>('svg')!
    const value = root.querySelector<HTMLElement>('[data-value]')!
    const table = root.querySelector<HTMLElement>('[data-table]')!
    const kind = root.dataset.kind
    const shape = (
      name: string,
      attrs: Record<string, string | number>,
      body?: string,
    ) => {
      const el = document.createElementNS(NS, name)
      for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v))
      if (body) el.textContent = body
      svg.append(el)
      return el
    }
    const redraw = () => {
      svg.replaceChildren()
      table.replaceChildren()
      if (kind === 'bcww') {
        const isInvalid =
          root.querySelector<HTMLSelectElement>('[data-witness]')!.value ===
          'invalid'
        const atoms = isInvalid ? invalid : corrected
        const values = terms.map(([s, c]) => ({
          s,
          c,
          h: entropy(atoms, [1, 1, 1, 1, 1], s),
        }))
        const total = values.reduce((v, t) => v + t.c * t.h, 0)
        shape('line', { x1: 310, x2: 310, y1: 20, y2: 215, class: 'axis' })
        values.forEach((t, i) => {
          const v = t.c * t.h,
            px = 310 + v * 48
          const mark = shape('rect', {
            x: Math.min(px, 310),
            y: 15 + i * 18,
            width: Math.abs(v) * 48,
            height: 12,
            class: v < 0 ? 'negative' : 'positive',
            tabindex: 0,
            role: 'img',
            'aria-label': `${t.c} H(${t.s}) contributes ${v.toFixed(9)} bits`,
          })
          tooltip.bind(mark, `${t.c} H(${t.s})`, [
            `Entropy: ${t.h.toFixed(9)} bits`,
            `Coefficient: ${t.c}`,
            `Contribution to F: ${v.toFixed(9)} bits`,
          ])
          shape(
            'text',
            { x: 290, y: 25 + i * 18, 'text-anchor': 'end', class: 'label' },
            `${t.c} H(${t.s})`,
          )
        })
        shape(
          'text',
          { x: 310, y: 243, 'text-anchor': 'middle', class: 'label' },
          'Signed contribution (bits)',
        )
        value.textContent = `LHS = ${total.toFixed(12)} bits. ${total > 0 ? 'The proposed upper bound is violated.' : 'This atom set does not violate the inequality.'}`
        const p = document.createElement('p')
        p.textContent = `Uniform mass 1/5 on ${atoms.join(', ')}.`
        table.append(p)
      } else if (kind === 'apn') {
        drawApn()
      } else if (kind === 'ghz') {
        const p = Number(
          root.querySelector<HTMLInputElement>('[data-mixture]')!.value,
        )
        root.querySelector('output')!.textContent = p.toFixed(2)
        const samples = Array.from({ length: 99 }, (_, i) => ({
          p: (i + 1) / 100,
          v: score((i + 1) / 100),
        }))
        const lower = Math.min(...samples.map((s) => s.v)),
          upper = Math.max(...samples.map((s) => s.v), 0) + 0.08
        const xx = (p: number) => 50 + p * 540,
          yy = (v: number) => 210 - ((v - lower) / (upper - lower)) * 185
        shape('line', { x1: 50, x2: 590, y1: yy(0), y2: yy(0), class: 'axis' })
        shape('path', {
          d: samples
            .map((s, i) => `${i ? 'L' : 'M'} ${xx(s.p)} ${yy(s.v)}`)
            .join(' '),
          class: 'curve',
        })
        shape('circle', {
          cx: xx(p),
          cy: yy(score(p)),
          r: 5,
          class: 'positive',
        })
        shape('text', { x: 50, y: 240, class: 'label' }, '0')
        shape('text', { x: 590, y: 240, class: 'label' }, '1')
        shape(
          'text',
          { x: 310, y: 240, 'text-anchor': 'middle', class: 'label' },
          'GHZ weight p',
        )
        shape('text', { x: 50, y: yy(0) - 8, class: 'label' }, 'LHS = 0')
        shape(
          'text',
          { x: 50, y: 215, class: 'label' },
          `${lower.toFixed(2)} bits`,
        )
        value.textContent = `At p = ${p.toFixed(2)}, LHS = ${score(p).toFixed(9)} bits.`
      }
    }
    const sup = (n: number) =>
      [...String(n)].map((d) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[Number(d)]).join('')
    // Exact F_32 arithmetic on 5-bit integers; the modulus is the bit pattern of an irreducible quintic.
    const drawApn = () => {
      const mod = Number(
        root.querySelector<HTMLSelectElement>('[data-apn-modulus]')!.value,
      )
      const witness =
        root.querySelector<HTMLSelectElement>('[data-apn-function]')!
          .value === 'witness'
      const q = 32
      const mul = (a: number, b: number) => {
        let r = 0
        while (b) {
          if (b & 1) r ^= a
          b >>= 1
          a <<= 1
          if (a & q) a ^= mod
        }
        return r
      }
      const pow = (a: number, e: number) => {
        let r = 1
        for (let i = 0; i < e; i++) r = mul(r, a)
        return r
      }
      const F = Array.from({ length: q }, (_, x) =>
        pow(witness ? x ^ pow(x, 8) ^ pow(x, 16) : x, 3),
      )
      // Reduced representative: a_0 = F(0), a_k = sum over c != 0 of F(c) c^(q-1-k), a_(q-1) = sum of F(c).
      const coef = Array.from({ length: q }, (_, k) => {
        if (k === 0) return F[0]
        if (k === q - 1) return F.reduce((s, v) => s ^ v, 0)
        let s = 0
        for (let c = 1; c < q; c++) s ^= mul(F[c], pow(c, q - 1 - k))
        return s
      })
      const deriv = Array.from({ length: q }, (_, a) => {
        let s = 0
        for (let k = 1; k < q; k += 2)
          if (coef[k]) s ^= mul(coef[k], pow(a, k - 1))
        return s
      })
      let uniformity = 0
      for (let a = 1; a < q; a++) {
        const count = new Array<number>(q).fill(0)
        for (let x = 0; x < q; x++) count[F[x ^ a] ^ F[x]]++
        uniformity = Math.max(uniformity, ...count)
      }
      const permutation = new Set(F).size === q
      const critical = deriv.filter((v) => v === 0).length
      deriv.forEach((d, a) => {
        const x = 34 + (a % 8) * 70,
          y = 12 + Math.floor(a / 8) * 52
        const cell = shape('rect', {
          x,
          y,
          width: 62,
          height: 44,
          rx: 3,
          class: d ? 'positive' : 'critical',
          tabindex: 0,
          role: 'img',
          'aria-label': `Element ${a}: f prime is ${d}${d ? '' : ', a critical point'}`,
        })
        tooltip.bind(cell, `Element ${a} (bits ${a.toString(2).padStart(5, '0')})`, [
          `F(a) = ${F[a]}`,
          `f′(a) = ${d}${d ? '' : ', a critical point'}`,
        ])
        shape(
          'text',
          { x: x + 31, y: y + 27, 'text-anchor': 'middle', class: 'cell-label' },
          String(a),
        )
      })
      const terms = coef
        .map((c, k) => [c, k])
        .filter(([c]) => c)
        .reverse()
        .map(([c, k]) =>
          (c === 1 ? '' : `${c}·`) + (k === 0 ? '1' : k === 1 ? 'x' : `x${sup(k)}`),
        )
      value.textContent = `${permutation ? 'Permutation' : 'Not a permutation'}, differential uniformity ${uniformity}. Critical points: ${critical} of ${q}.`
      const p = document.createElement('p')
      p.textContent = `Reduced polynomial f = ${terms.join(' + ')}.`
      table.append(p)
    }
    for (const select of root.querySelectorAll('select'))
      select.addEventListener('change', redraw)
    root.querySelector('input')?.addEventListener('input', redraw)
    if (kind !== 'lw6') redraw()
    else {
      // The finite certificate data is a small static artifact, independent of the viewer.
      fetch('/research/lw6-intervals.json')
        .then((r) => {
          if (!r.ok) throw new Error('Certificate data unavailable')
          return r.json()
        })
        .then((rows) => {
          const update = () => {
            svg.replaceChildren()
            const L = Number(
              root.querySelector<HTMLInputElement>('[data-ladder]')!.value,
            )
            root.querySelector('output')!.textContent = String(L)
            shape('line', { x1: 50, x2: 590, y1: 210, y2: 210, class: 'axis' })
            for (let i = 2; i <= 16; i += 2) {
              const yy = 210 - ((i - 2) / 14) * 175
              shape(
                'text',
                { x: 40, y: yy + 4, 'text-anchor': 'end', class: 'label' },
                `10^${i}`,
              )
            }
            for (const row of rows) {
              const xx = 50 + ((row.L - 2) / 14) * 540,
                yy = 210 - ((Math.log10(Number(row.lower)) - 2) / 14) * 175
              shape('circle', {
                cx: xx,
                cy: yy,
                r: row.L === L ? 6 : 3,
                class: row.L === L ? 'positive' : 'point',
              })
            }
            shape('text', { x: 50, y: 240, class: 'label' }, 'L = 2')
            shape(
              'text',
              { x: 590, y: 240, 'text-anchor': 'end', class: 'label' },
              'L = 16',
            )
            for (const mark of svg.querySelectorAll<SVGCircleElement>(
              'circle',
            )) {
              const index = [...svg.querySelectorAll('circle')].indexOf(mark),
                row = rows[index]
              mark.setAttribute('tabindex', '0')
              tooltip.bind(mark, `Family member L = ${row.L}`, [
                `Certified R lower bound: ${row.lower}`,
                `Certified R upper bound: ${row.upper}`,
              ])
            }
            const row = rows.find((r: { L: number }) => r.L === L)
            value.textContent = `L = ${L}: R is at least ${Number(row.lower).toExponential(9)} (rounded display).`
            table.replaceChildren()
            const a = document.createElement('a')
            a.href = '/research/lw6-intervals.json'
            a.textContent = 'Exact interval endpoints'
            table.append(a)
          }
          root.querySelector('input')!.addEventListener('input', update)
          update()
        })
        .catch(() => {
          value.textContent =
            'The certificate plot could not load. The mathematical statement and linked verifier remain available.'
        })
    }
  }
</script>
<style>
  .witness-explorer {
    margin: 1rem 0;
    padding: 0.65rem 0;
    border-block: 1px solid var(--border);
  }
  label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font: 0.75rem var(--font-mono);
  }
  select {
    max-width: 100%;
    background: var(--bg);
    color: var(--fg);
    padding: 0.5rem;
    font: inherit;
    border: 1px solid var(--border-strong);
  }
  input {
    flex: 1;
    min-width: 5rem;
    accent-color: var(--c-info);
  }
  svg {
    width: 100%;
    margin: 0.5rem 0;
    max-height: 14rem;
  }
  svg :global(.axis) {
    stroke: var(--border-strong);
  }
  svg :global(.label) {
    fill: var(--fg-muted);
    font: 12px var(--font-mono);
  }
  svg :global(.negative),
  svg :global(.point) {
    fill: var(--fg-faint);
  }
  svg :global(.positive) {
    fill: var(--c-ok);
  }
  svg :global(.critical) {
    fill: var(--c-fail);
  }
  svg :global(.cell-label) {
    fill: var(--bg);
    font: 13px var(--font-mono);
    pointer-events: none;
  }
  .pickers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  svg :global(.curve) {
    stroke: var(--c-info);
    stroke-width: 2;
    fill: none;
  }
  p {
    font-size: 0.9rem;
  }
  figcaption {
    font-size: 0.8rem;
  }
</style>
