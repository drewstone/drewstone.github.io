---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { byPublishedDesc } from '../../lib/ordering'
const results = (await getCollection('research')).sort(byPublishedDesc)
---

<Base
  title="Proofs & counterexamples"
  description="Explicit counterexamples, proofs, verification artifacts, and the recorded agent work behind them."
  wide
>
  <header class="opening">
    <h1>Proofs &amp; counterexamples</h1>
  </header>
  <ol class="results">
    {results.map((item, i) => (
      <li>
        <span class="number">{String(i + 1).padStart(2, '0')}</span>
        <div>
          <h2>
            <a href={`/research/${item.id}`}>{item.data.title}</a>
            <time datetime={item.data.published.toISOString()}>
              {item.data.published.toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric',
                timeZone: 'UTC',
              })}
            </time>
          </h2>
          <p>{item.data.claim}</p>
          <p class="limit">{item.data.limitation}</p>
        </div>
      </li>
    ))}
  </ol>
</Base>
<style>
  .opening {
    margin-bottom: 1rem;
  }
  h1 {
    font-size: 1.8rem;
  }
  .results {
    list-style: none;
    padding: 0;
  }
  .results li {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: 0.7rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--border);
  }
  .number {
    font: 0.72rem var(--font-mono);
    color: var(--fg-faint);
    padding-top: 0.2rem;
  }
  h2 {
    margin: 0 0 0.25rem;
    font-size: 1.12rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    flex-wrap: wrap;
  }
  h2 time {
    font: 0.72rem var(--font-mono);
    color: var(--fg-faint);
    white-space: nowrap;
  }
  .results p {
    margin-bottom: 0.25rem;
  }
  .limit {
    color: var(--fg-muted);
    font-size: 0.86rem;
  }
</style>
