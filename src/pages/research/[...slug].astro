---
import Base from '../../layouts/Base.astro'
import Figure from '../../components/Figure.astro'
import EvidenceExplorer from '../../components/EvidenceExplorer.astro'
import { getCollection, render } from 'astro:content'
import { readFile } from 'node:fs/promises'
import { fromResearchPublication } from '@drewstone/agent-record/adapters/research-publication'
export async function getStaticPaths() {
  return (await getCollection('research')).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}
const { entry } = Astro.props
const { Content, headings } = await render(entry)
const records = await Promise.all(
  entry.data.record_ids.map(async (id: string) => {
    if (!/^[a-z0-9-]+$/.test(id))
      throw new Error(`Invalid publication record id: ${id}`)
    return fromResearchPublication(
      JSON.parse(await readFile(`public/research/records/${id}.json`, 'utf8')),
    )
  }),
)
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  wide
>
  <p class="breadcrumb">
    <a href="/research">Research</a> / Quantum information
  </p>
  <header class="research-header">
    <h1>{entry.data.title}</h1>
    <p class="claim">{entry.data.claim}</p>
    <p class="date">
      Evidence assessed {entry.data.assessed.toISOString().slice(0, 10)}
    </p>
  </header>
  <div class="article-grid">
    <nav class="contents" aria-label="On this page">
      <ol>
        {headings
          .filter((h) => h.depth === 2)
          .map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        <li>
          <a href="#references">References</a>
        </li>
        {records.length > 0 && (
          <li>
            <a href="#agent-record">Agent record</a>
          </li>
        )}
      </ol>
    </nav>
    <article class="prose">
      {entry.data.figure && <Figure {...entry.data.figure} />}
      <Content />
    </article>
  </div>
  {records.length > 0 && (
    <section id="agent-record" class="record">
      <h2>Agent record</h2>
      <EvidenceExplorer records={records} />
    </section>
  )}
  <aside id="publication-note" class="publication-note">
    <h2>Publication note</h2>
    <p>
      Page curated with Codex, October 2, 2026. Research attribution is recorded
      above.
    </p>
    <p>
      <a href="https://github.com/drewstone/drewstone.github.io/commits/main/src/content/research">
        Page history
      </a>
    </p>
  </aside>
</Base>
<style>
  .breadcrumb,
  .date {
    font: 0.7rem var(--font-mono);
    color: var(--fg-muted);
  }
  .research-header {
    max-width: 51rem;
    margin: 0.7rem 0 1.1rem;
  }
  h1 {
    font-size: clamp(1.55rem, 4vw, 1.9rem);
  }
  .claim {
    font-size: 1rem;
  }
  .article-grid {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 1.5rem;
  }
  .contents {
    align-self: start;
    position: sticky;
    top: 1.5rem;
    font-size: 0.85rem;
  }
  .contents ol {
    padding: 0;
    list-style: none;
  }
  .contents li {
    padding: 0.15rem 0;
  }
  .prose {
    min-width: 0;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(pre) {
    margin-left: 0;
    margin-right: 0;
    padding: 1rem;
    font-size: 0.8rem;
  }
  /* The global table breakout (-3rem each side) would cover the contents column. */
  .prose :global(table) {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
  }
  .record {
    margin-top: 1.75rem;
  }
  .publication-note {
    max-width: none;
    margin: 1.2rem 0 0;
    color: var(--fg-muted);
    font-size: 0.85rem;
  }
  .publication-note h2 {
    font-size: 1.1rem;
  }
  @media (max-width: 800px) {
    .article-grid {
      display: block;
    }
    .contents {
      position: static;
      border-block: 1px solid var(--border);
      padding: 0.7rem 0;
      margin-bottom: 1rem;
    }
    .contents ol {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1rem;
      margin: 0;
    }
  }
</style>
