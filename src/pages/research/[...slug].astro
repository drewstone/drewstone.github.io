---
import Base from '../../layouts/Base.astro'
import Figure from '../../components/Figure.astro'
import EvidenceExplorer from '../../components/EvidenceExplorer.astro'
import { getCollection, render } from 'astro:content'
import { readFile } from 'node:fs/promises'
import { parseRecord } from '@drewstone/agent-record/record'
import { readFileSync, existsSync } from 'node:fs'
export async function getStaticPaths() {
  return (await getCollection('research')).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}
const { entry } = Astro.props
const { Content, headings } = await render(entry)
// Each record is the checked public projection of its manifest (tools/research-records.mjs check).
const records = await Promise.all(
  entry.data.record_ids.map(async (id: string) =>
    parseRecord(JSON.parse(await readFile(`public/research/records/${id}.json`, 'utf8'))),
  ),
)
// A replay is reviewed and checked like a record, but no store build has signed it (research/replays).
const replays = await Promise.all(
  entry.data.replay_ids.map(async (id: string) =>
    parseRecord(JSON.parse(await readFile(`public/research/replays/${id}.json`, 'utf8'))),
  ),
)
const shown = [...records, ...replays]
const downloads = Object.fromEntries([
  ...entry.data.record_ids.map((id: string) => [id, `/research/records/${id}.json`]),
  ...entry.data.replay_ids.map((id: string) => [id, `/research/replays/${id}.json`]),
])
const { records: allIds } = JSON.parse(await readFile('research/publications/idmap.json', 'utf8'))
// Behavior battery reports are build-time static data, like the records themselves.
const behaviorReports = entry.data.record_ids
  .filter((id: string) => existsSync(`public/research/behaviors/${id}.json`))
  .map((id: string) => JSON.parse(readFileSync(`public/research/behaviors/${id}.json`, 'utf8')))
const idmap = Object.fromEntries(entry.data.record_ids.map((id: string) => [id, allIds[id] ?? {}]))
const sectionLinks = [
  ...headings.filter((heading) => heading.depth === 2).map((heading) => ({ href: `#${heading.slug}`, label: heading.text })),
  { href: '#references', label: 'References' },
  ...(shown.length > 0 ? [{ href: '#agent-record', label: 'Agent record' }] : []),
]
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  wide
>
  <p class="breadcrumb">
    <a href="/research">Research</a> / {entry.data.area}
  </p>
  <header class="research-header">
    <h1>{entry.data.title}</h1>
    <p class="claim">{entry.data.claim}</p>
    <p class="date">
      Evidence assessed {entry.data.assessed.toISOString().slice(0, 10)} ·{' '}
      <a href="https://github.com/drewstone/drewstone.github.io/commits/main/src/content/research">
        Page history
      </a>
    </p>
  </header>
  <div class="article-feed">
    <details class="page-contents">
      <summary>
        On this page
        <span class="page-contents-count">{sectionLinks.length}</span>
      </summary>
      <nav aria-label="On this page">
        <ol>
          {sectionLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
    <article class="prose">
      {entry.data.figure && <Figure {...entry.data.figure} />}
      <Content />
    </article>
  </div>
  <script>
    const box = document.querySelector('.page-contents')
    if (box instanceof HTMLDetailsElement) {
      const close = () => {
        box.open = false
      }
      box.querySelectorAll('a').forEach((link) => link.addEventListener('click', close))
      document.addEventListener('click', (event) => {
        if (!box.open || !(event.target instanceof Node) || box.contains(event.target)) return
        close()
      })
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && box.open) close()
      })
    }
  </script>
  {shown.length > 0 && (
    <section id="agent-record" class="record">
      <h2>Agent record</h2>
      {replays.length > 0 && (
        <p class="record-status">
          Reviewed replay, not store-signed. It is built from the run's retained traces with the same converter and review
          as a signed record, but the evidence store holds no snapshot of this run, so no store build has reproduced and
          signed it. Every published body names its source line and that line's sha256.
        </p>
      )}
      <EvidenceExplorer records={shown} idmap={idmap} behaviors={behaviorReports} downloads={downloads} />
    </section>
  )}
</Base>
<style>
  .breadcrumb,
  .date {
    font: 0.7rem var(--font-mono);
    color: var(--fg-muted);
  }
  .research-header,
  .article-feed {
    max-width: var(--max-width);
    margin-left: auto;
    margin-right: auto;
  }
  .research-header {
    margin-top: 0.7rem;
    margin-bottom: 1.1rem;
  }
  h1 {
    font-size: clamp(1.55rem, 4vw, 1.9rem);
  }
  .claim {
    font-size: 1rem;
  }
  .page-contents {
    position: sticky;
    top: 0.4rem;
    z-index: 4;
    margin: 0 0 1.25rem;
    font: 0.72rem var(--font-mono);
  }
  .page-contents > summary {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    width: fit-content;
    padding: 0.15rem 0;
    color: var(--fg-muted);
    background: var(--bg);
    cursor: pointer;
    list-style: none;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .page-contents > summary::-webkit-details-marker {
    display: none;
  }
  .page-contents > summary::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.1rem) rotate(-45deg);
  }
  .page-contents[open] > summary::before {
    transform: translateY(0.05rem) rotate(45deg);
  }
  .page-contents-count {
    color: var(--fg-faint);
    letter-spacing: 0;
    text-transform: none;
  }
  .page-contents nav {
    position: absolute;
    z-index: 5;
    left: 0;
    right: 0;
    max-height: min(70vh, 24rem);
    overflow: auto;
    margin-top: 0.2rem;
    padding: 0.45rem 0.8rem;
    background: var(--bg);
    border: 1px solid var(--border);
  }
  .page-contents ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .page-contents a {
    display: block;
    padding: 0.28rem 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    letter-spacing: 0;
    text-transform: none;
    text-decoration: none;
  }
  .page-contents a:hover {
    text-decoration: underline;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  /* Plots use the wide container's side margins. Text stays on the reading measure. */
  .prose :global(.witness-explorer) {
    margin-left: calc(-1 * var(--space-lg));
    margin-right: calc(-1 * var(--space-lg));
  }
  @media (min-width: 800px) {
    .prose :global(.witness-explorer) {
      margin-left: -5rem;
      margin-right: -5rem;
    }
  }
  .record {
    margin-top: 1.75rem;
  }
  .record-status {
    max-width: var(--max-width);
    margin: 0 auto 0.9rem;
    font-size: 0.9rem;
    color: var(--fg-muted);
  }
</style>
