---
import Base from '../layouts/Base.astro'
---

<Base
  title="Open problems"
  description="A living census of unsolved problems across mathematics, computer science, cryptography, the sciences, and engineering."
>
  <nav id="op-breadcrumb" class="op-breadcrumb"></nav>
  <div id="op-view"></div>

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.38/dist/katex.min.css"
    crossorigin="anonymous"
  />
  <script is:inline src="https://cdn.jsdelivr.net/npm/katex@0.16.38/dist/katex.min.js" crossorigin="anonymous"></script>
  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/katex@0.16.38/dist/contrib/auto-render.min.js"
    crossorigin="anonymous"
  ></script>

  <style is:global>
    /* atlas */
    .op-atlas-wrap { position: relative; }
    #op-atlas { width: 100%; height: 72vh; display: block; cursor: crosshair; background: var(--bg); }
    .op-atlas-tip { position: absolute; pointer-events: none; background: var(--bg); border: 1px solid var(--border-strong);
      padding: 0.25rem 0.5rem; font: 0.72rem var(--font-mono); color: var(--fg-muted); max-width: 260px; display: none; }
    .op-atlas-legend { font: 0.7rem var(--font-mono); color: var(--fg-faint); margin-top: 0.5rem; }
    .op-atlas-legend .sw { display: inline-block; width: 0.55rem; height: 0.55rem; border-radius: 50%; margin: 0 0.25rem 0 0.8rem; }
    /* sparkline */
    .op-spark { display: block; margin-top: 0.4rem; }
    /* facet rows reuse op-rows */
    /* open problems — set in the house style. headings, rows, hairlines reuse the
       blog's own scale (h1 1.8/700, rows like the research index). */
    .op-breadcrumb {
      font: 0.72rem var(--font-mono);
      color: var(--fg-faint);
      margin-bottom: 2.2rem;
      min-height: 1rem;
      letter-spacing: 0.02em;
    }
    .op-breadcrumb a { color: var(--fg-muted); text-decoration: none; }
    .op-breadcrumb a:hover { color: var(--fg); text-decoration: underline; }
    .op-breadcrumb .sep { margin: 0 0.45rem; color: var(--border-strong); }

    /* frontispiece — once, home only */
    .op-front .epigraph { font-style: italic; color: var(--fg-muted); margin: 0 0 0.3rem; }
    .op-front .epigraph-src { font: 0.78rem var(--font-mono); color: var(--fg-faint); margin-bottom: 2.6rem; }
    .op-census-line { font: 0.78rem var(--font-mono); color: var(--fg-faint); margin-bottom: 2.4rem; }
    .op-census-line b { color: var(--fg-muted); font-weight: 500; }

    /* table of contents, book style */
    .op-toc { column-count: 2; column-gap: 3rem; }
    @media (max-width: 719px) { .op-toc { column-count: 1; } }
    .op-toc a {
      display: flex; align-items: baseline; gap: 0.5rem;
      text-decoration: none; color: var(--fg);
      padding: 0.16rem 0; break-inside: avoid; font-size: 0.95rem;
    }
    .op-toc a:hover .n { text-decoration: underline; }
    .op-toc .leader { flex: 1; border-bottom: 1px dotted var(--border-strong); transform: translateY(-0.22em); }
    .op-toc .count { font: 0.72rem var(--font-mono); color: var(--fg-faint); }

    /* search */
    .op-search { width: 100%; font-family: var(--font-body); font-size: 1.02rem;
      padding: 0.45rem 0.1rem; border: 0; border-bottom: 1px solid var(--border-strong);
      background: transparent; color: var(--fg); outline: none; margin-bottom: 1.8rem; }
    .op-search:focus { border-bottom-color: var(--fg); }
    .op-search::placeholder { color: var(--fg-faint); font-style: italic; }

    /* domain page — the research-index row pattern */
    .op-domain-head .n { font: 0.76rem var(--font-mono); color: var(--fg-faint); margin-top: 0.15rem; }
    .op-rows { list-style: none; padding: 0; }
    .op-rows li { display: grid; grid-template-columns: 5.4rem 1fr; gap: 0.7rem;
      padding: 0.6rem 0; border-top: 1px solid var(--border); }
    .op-rows li:last-child { border-bottom: 1px solid var(--border); }
    .op-rows .pid { font: 0.7rem var(--font-mono); color: var(--fg-faint); padding-top: 0.28rem; }
    .op-rows a.prob { color: var(--fg); text-decoration: none; }
    .op-rows a.prob:hover { text-decoration: underline; }
    .op-rows a.prob h2 { margin: 0; font-size: 1.02rem; }
    .op-rows .stat { margin: 0.15rem 0 0; color: var(--fg-muted); font-size: 0.88rem; }
    .op-rows .marks { font: 0.68rem var(--font-mono); }
    .op-rows .prize { color: var(--c-run); }
    .op-rows .solved { color: var(--c-fail); }
    .op-subfield h3 { margin-top: 1.8rem; }
    .op-famous { margin-top: 2.4rem; }
    .op-famous summary { font: 0.78rem var(--font-mono); color: var(--fg-faint); cursor: pointer; padding: 0.5rem 0; }
    .op-famous summary:hover { color: var(--fg-muted); }

    /* problem page — a set theorem; the statement is the page's center */
    .op-problem h1 { max-width: 44rem; }
    .op-statement {
      font-size: 1.12rem; line-height: 1.65; max-width: 42rem;
      margin: 1.6rem 0 2.4rem; color: var(--fg);
    }
    .op-statement .lead { font-variant: small-caps; letter-spacing: 0.05em; color: var(--fg-muted); }
    .op-fields { max-width: 42rem; }
    .op-field { margin: 1.5rem 0; }
    .op-field > .k { font: 500 0.72rem var(--font-mono); letter-spacing: 0.05em;
      text-transform: lowercase; color: var(--fg-faint); margin-bottom: 0.3rem; }
    .op-field > .v { font-size: 0.98rem; line-height: 1.6; }
    .op-field > .v.muted { color: var(--fg-muted); font-size: 0.9rem; }
    .op-rule { border: 0; border-top: 1px solid var(--border); margin: 2rem 0; max-width: 42rem; }
    .op-rule.strong { border-top: 1px solid var(--rule); }

    /* citations — reference list */
    .op-cite { margin: 0.4rem 0; font-size: 0.92rem; line-height: 1.5; }
    .op-cite .num { font: 0.7rem var(--font-mono); color: var(--fg-faint); margin-right: 0.5rem; }
    .op-cite a { color: var(--fg); text-decoration: none; border-bottom: 1px solid var(--border-strong); }
    .op-cite a:hover { border-bottom-color: var(--fg); }
    .op-cite .src { font: 0.66rem var(--font-mono); color: var(--c-info); margin-left: 0.3rem; }
    .op-tools a { font: 0.72rem var(--font-mono); color: var(--fg-muted); text-decoration: none;
      border: 1px solid var(--border); border-radius: 3px; padding: 0.1rem 0.5rem;
      margin: 0.6rem 0.35rem 0 0; display: inline-block; }
    .op-tools a:hover { color: var(--fg); border-color: var(--border-strong); background: var(--bg-alt); }

    .op-edge { margin: 0.28rem 0; font-size: 0.95rem; }
    .op-edge .rel { font-variant: small-caps; letter-spacing: 0.04em; color: var(--fg-faint); margin-right: 0.45rem; }
    .op-edge a { color: var(--fg); }
    .op-colophon { font: 0.7rem var(--font-mono); color: var(--fg-faint); margin-top: 2.4rem; }

    .op-graze { display: flex; justify-content: space-between; margin-top: 2.6rem;
      padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.88rem; }
    .op-graze a { color: var(--fg-muted); text-decoration: none; max-width: 46%; }
    .op-graze a:hover { color: var(--fg); }
    .op-graze .dir { font: 0.68rem var(--font-mono); color: var(--fg-faint); display: block; }
    .op-graze .dir.r { text-align: right; }

    .op-empty { color: var(--fg-muted); font-style: italic; font-size: 0.9rem; }
    @media print { .op-breadcrumb, .op-tools, .op-graze, .op-search { display: none; } }
  </style>

  <script>
    const manifest = await fetch('/problems-data/manifest.json').then((r) => r.json())
    const edges = await fetch('/problems-data/edges.json').then((r) => r.json())
    const idsToDom = await fetch('/problems-data/ids.json').then((r) => r.json())
    const facets = await fetch('/problems-data/facets.json').then((r) => r.json()).catch(() => ({}))
    const frontier = await fetch('/problems-data/frontier.json').then((r) => r.json()).catch(() => [])
    let atlasPts: any[] | null = null
    const atlas = async () => { if (!atlasPts) atlasPts = await fetch('/problems-data/atlas.json').then((r) => r.json()); return atlasPts }
    const total = Object.values(manifest).reduce((a: any, b: any) => a + b, 0)

    const cache: Record<string, any[]> = {}
    async function domain(slug: string) {
      if (!cache[slug]) cache[slug] = await fetch(`/problems-data/${slug}.json`).then((r) => r.json())
      return cache[slug]
    }
    const byId: Record<string, any> = {}
    const esc = (s: any) => { const d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML }
    const scholar = (q: string) => 'https://scholar.google.com/scholar?q=' + encodeURIComponent(q)

    function typeset(el: HTMLElement) {
      const w = (window as any)
      if (w.renderMathInElement)
        w.renderMathInElement(el, { delimiters: [
          { left: '$$', right: '$$', display: true }, { left: '$', right: '$', display: false },
          { left: '\\(', right: '\\)', display: false }, { left: '\\[', right: '\\]', display: true },
        ], throwOnError: false })
    }

    function parseCite(c: string) {
      c = c.trim(); let m
      if ((m = c.match(/arxiv\.org\/abs\/([0-9a-z.]+v?\d*)/i)) || (m = c.match(/arXiv:([0-9]{4}\.[0-9]{4,5})/i)))
        return { label: c, url: `https://arxiv.org/abs/${m[1]}`, src: 'arxiv' }
      if ((m = c.match(/eprint\.iacr\.org\/(\d{4}\/\d+)/i)) || (m = c.match(/(?:eprint|ePrint)\s*:?\s*(\d{4}\/\d+)/)))
        return { label: c, url: `https://eprint.iacr.org/${m[1]}`, src: 'iacr' }
      if ((m = c.match(/(10\.\d{4,9}\/[^\s;,)]+)/))) return { label: c, url: `https://doi.org/${m[1]}`, src: 'doi' }
      if ((m = c.match(/(https?:\/\/[^\s;,)]+)/))) return { label: c, url: m[1], src: '↗' }
      return { label: c, url: scholar(c), src: 'scholar' }
    }
    function citesHTML(kw: string) {
      if (!kw) return ''
      return kw.split(/;/).map((x: string) => x.trim()).filter(Boolean).slice(0, 14)
        .map((c: string, i: number) => { const p: any = parseCite(c)
          return `<div class="op-cite"><span class="num">[${i + 1}]</span><a href="${p.url}" target="_blank" rel="noopener">${esc(p.label)}</a><span class="src">${p.src}</span></div>` }).join('')
    }

    const crumb = document.getElementById('op-breadcrumb')!
    const view = document.getElementById('op-view')!

    function rowHTML(r: any) {
      const marks = (r.prize ? '<span class="prize">✦</span>' : '') + (r.solved ? '<span class="solved"> solved?</span>' : '')
      const stat = r.status ? `<p class="stat">${esc(r.status.slice(0, 160))}</p>` : ''
      return `<li><span class="pid">${r.id}</span><div>
        <a class="prob" href="#/p/${r.id}"><h2>${esc(r.title)}</h2></a>${stat}
        ${marks ? `<p class="marks">${marks}</p>` : ''}</div></li>`
    }

    function homeHTML() {
      const toc = Object.entries(manifest).map(([slug, n]: any) =>
        `<a href="#/d/${slug}"><span class="n">${esc(slug)}</span><span class="leader"></span><span class="count">${n.toLocaleString()}</span></a>`).join('')
      return `<div class="op-front">
        <h1>Open problems</h1>
        <p class="epigraph">Wir müssen wissen — wir werden wissen.</p>
        <div class="epigraph-src">Hilbert, 1930 — engraved on his tombstone. This is what the sentence still owes.</div>
        <div class="op-census-line"><b>${total.toLocaleString()}</b> problems · <b>${Object.keys(manifest).length}</b> domains · citations linked · status checked against the literature</div>
        <p style="font:0.8rem var(--font-mono);margin-bottom:2rem"><a href="#/atlas" style="color:var(--fg-muted)">→ the atlas — every problem, one sky</a> &nbsp;·&nbsp; <a href="#/frontier" style="color:var(--fg-muted)">→ the frontier — the newest unknowns</a></p>
        <input id="op-search" class="op-search" type="search" placeholder="search the census — press /" aria-label="Search problems">
        <div id="op-search-out"></div>
        <div class="op-toc">${toc}</div>
        <p style="margin-top:2.4rem"><a href="#/famous" style="font:0.78rem var(--font-mono);color:var(--fg-faint)">the famous ones — millennium prizes and named conjectures, collected for completeness</a></p></div>`
    }

    async function domainHTML(slug: string) {
      const rows = await domain(slug); rows.forEach((r: any) => (byId[r.id] = r))
      const tail = rows.filter((r: any) => (r.sig || 0) < 5)
      const famous = rows.filter((r: any) => (r.sig || 0) >= 5)
      const groups = new Map<string, any[]>()
      for (const r of tail) { const k = r.subfield || 'general'; (groups.get(k) || groups.set(k, []).get(k)!).push(r) }
      let h = `<div class="op-domain-head"><h1>${esc(slug)}</h1><div class="n">${rows.length.toLocaleString()} problems · ${famous.length.toLocaleString()} well-known sectioned</div></div>`
      for (const [sub, rs] of groups)
        h += `<div class="op-subfield"><h3>${esc(sub)} · ${rs.length}</h3><ol class="op-rows">${rs.map(rowHTML).join('')}</ol></div>`
      if (famous.length)
        h += `<details class="op-famous"><summary>the well-known ones · ${famous.length} — collected for completeness</summary><ol class="op-rows">${famous.map(rowHTML).join('')}</ol></details>`
      const facetIds: string[] = (facets as any)[slug] || []
      if (facetIds.length) {
        const fr = facetIds.slice(0, 120).map((fid: string) => {
          const rr = byId[fid]
          if (!rr) return ''
          return `<li><span class="pid">${rr.id}</span><div><a class="prob" href="#/p/${rr.id}"><h2>${esc(rr.title)}</h2></a><p class="stat">${esc(rr.domain)}</p></div></li>`
        }).join('')
        h += `<div class="op-subfield"><h3>from neighboring domains · ${facetIds.length}</h3><ol class="op-rows">${fr}</ol></div>`
      }
      return h
    }

    async function famousHTML() {
      const all: any[] = []
      for (const slug of Object.keys(manifest)) {
        const rows = await domain(slug)
        rows.forEach((r: any) => (byId[r.id] = r))
        for (const r of rows) if ((r.sig || 0) >= 5) all.push(r)
      }
      all.sort((a: any, b: any) => (b.sig || 0) - (a.sig || 0))
      return `<div class="op-domain-head"><h1>The famous ones</h1><div class="n">the problems everyone already knows — millennium prizes, named conjectures, the canon. collected here for completeness so the census is complete, but the interesting work is in the tail.</div></div>
        <ol class="op-rows">${all.map(rowHTML).join('')}</ol>`
    }

    async function problemHTML(id: string) {
      const slug = idsToDom[id]
      if (!slug) return `<p class="op-empty">no such problem</p>`
      const rows = await domain(slug); rows.forEach((r: any) => (byId[r.id] = r))
      const r = byId[id]; if (!r) return `<p class="op-empty">not found</p>`
      const idx = rows.findIndex((x: any) => x.id === id)
      const prev = rows[idx - 1], next = rows[idx + 1]
      const rel = edges.filter((e: any) => e.a === id || e.b === id)
        .map((e: any) => { const o = e.a === id ? e.b : e.a; const or = byId[o]
          return `<div class="op-edge"><span class="rel">${esc(e.type)}</span><a href="#/p/${o}">${esc(or ? or.title : o)}</a></div>` }).join('')
      const pm = (r.parent || '').match(/[A-Z]+-\d+/)
      const parent = pm ? `<div class="op-edge"><span class="rel">part of</span><a href="#/p/${pm[0]}">${pm[0]}</a></div>` : ''
      const s2 = r.bib?.oa?.doi || r.bib?.oa?.id ? (r.bib.oa.doi || `https://openalex.org/${r.bib.oa.id}`) : null
      const bMile = (r.bib?.milestones || []).map((m: any) =>
        `<div class="op-cite"><span class="num">★</span><a href="${m.doi || 'https://openalex.org/' + m.id}" target="_blank" rel="noopener">${esc(m.a)} (${m.y}) ${esc((m.t || '').slice(0, 110))}</a><span class="src">${m.c || 0} cites</span></div>`).join('')
      const bRec = (r.bib?.recent || []).map((m: any) =>
        `<div class="op-cite"><span class="num">·</span><a href="${m.doi || 'https://openalex.org/' + m.id}" target="_blank" rel="noopener">${esc(m.a)} (${m.y}) ${esc((m.t || '').slice(0, 110))}</a><span class="src">${m.c || 0}</span></div>`).join('')
      const field = (k: string, v: string, cls = '') =>
        v ? `<div class="op-field"><div class="k">${k}</div><div class="v ${cls}">${esc(v)}</div></div>` : ''
      const cites = citesHTML(r.key_works)
      const years: number[] = [...(r.bib?.milestones || []), ...(r.bib?.recent || [])].map((m: any) => m.y).filter(Boolean)
      const spark = years.length ? sparkline(years) : ''
      return `<article class="op-problem">
        <h1>${esc(r.title)}</h1>
        ${r.open ? `<p class="op-statement"><span class="lead">open —</span> ${esc(r.open)}</p>` : ''}
        <hr class="op-rule strong">
        <div class="op-fields">
        ${field('status', r.status)}
        ${field('why it matters', r.why, 'muted')}
        ${field('prize', r.prize ? '✦ ' + r.prize : '')}
        ${r.solved ? `<div class="op-field"><div class="k">solved-candidate · under review</div><div class="v muted">${esc(r.solved.paper || '')}${r.solved.year ? ' (' + r.solved.year + ')' : ''}</div></div>` : ''}
        ${field('also known as', r.aliases, 'muted')}
        ${cites ? `<div class="op-field"><div class="k">prior work</div>${cites}
          <div class="op-tools">
            <a href="${scholar(r.title)}" target="_blank" rel="noopener">scholar</a>
            ${s2 ? `<a href="${s2}" target="_blank" rel="noopener">source paper</a>` : ''}
            <a href="https://openalex.org/works?filter=default.search%3A${encodeURIComponent(r.title)}" target="_blank" rel="noopener">openalex</a>
          </div></div>` : ''}
        ${bMile ? `<div class="op-field"><div class="k">milestone results — most-cited attacks</div>${bMile}</div>` : ''}
        ${bRec ? `<div class="op-field"><div class="k">recent attacks — 2023→</div>${bRec}</div>` : ''}
        ${spark ? `<div class="op-field"><div class="k">attack timeline</div>${spark}</div>` : ''}
        ${rel || parent ? `<div class="op-field"><div class="k">related</div>${parent}${rel}</div>` : ''}
        </div>
        <div class="op-colophon">${esc(r.id)} · ${esc(r.source || '')}</div>
        <div class="op-graze">
          ${prev ? `<a href="#/p/${prev.id}"><span class="dir">← previous</span>${esc(prev.title)}</a>` : '<span></span>'}
          ${next ? `<a href="#/p/${next.id}"><span class="dir r">next →</span>${esc(next.title)}</a>` : '<span></span>'}
        </div></article>`
    }

    let searchTimer: any = null
    function runSearch(q: string) {
      clearTimeout(searchTimer)
      const out = document.getElementById('op-search-out')!
      if (!q.trim()) { out.innerHTML = ''; return }
      searchTimer = setTimeout(async () => {
        const t = q.trim().toLowerCase(); const hits: any[] = []
        for (const slug of Object.keys(manifest)) {
          const rows = await domain(slug)
          for (const r of rows)
            if ((r.title + ' ' + (r.aliases || '') + ' ' + r.subfield + ' ' + (r.open || '').slice(0, 300)).toLowerCase().includes(t)) hits.push(r)
          if (hits.length >= 300) break
        }
        out.innerHTML = `<h3>search · ${hits.length.toLocaleString()} matches</h3><ol class="op-rows">${hits.slice(0, 300).map(rowHTML).join('') || '<p class="op-empty">no matches</p>'}</ol>`
        typeset(out)
      }, 160)
    }

    function sparkline(years: number[]) {
      const min = Math.min(...years), max = Math.max(...years)
      const W = 320, H = 34
      const counts = new Map<number, number>()
      for (const y of years) counts.set(y, (counts.get(y) || 0) + 1)
      const top = Math.max(...counts.values())
      let bars = ''
      for (let y = min; y <= max; y++) {
        const c = counts.get(y) || 0
        const bh = Math.max(1, Math.round((c / top) * (H - 12)))
        const x = ((y - min) / Math.max(1, max - min)) * (W - 6) + 3
        bars += `<rect x="${x.toFixed(1)}" y="${H - bh - 8}" width="3" height="${bh}" fill="var(--fg-muted)"/>`
      }
      return `<svg class="op-spark" width="${W}" height="${H}">${bars}<text x="3" y="${H - 1}" font-size="8" fill="var(--fg-faint)" font-family="var(--font-mono)">${min}</text><text x="${W - 20}" y="${H - 1}" font-size="8" fill="var(--fg-faint)" font-family="var(--font-mono)">${max}</text></svg>`
    }

    async function atlasHTML() {
      return `<div class="op-domain-head"><h1>The atlas</h1><div class="n">every problem, one sky — the bright stars are the unknown ones; the famous dim toward the center of their fields. drag to pan, scroll to zoom, click a star.</div></div>
      <div class="op-atlas-wrap"><canvas id="op-atlas"></canvas><div class="op-atlas-tip" id="op-atlas-tip"></div></div>
      <div class="op-atlas-legend">brightness = obscurity × attack-literature<span class="sw" style="background:var(--fg)"></span>problem<span class="sw" style="background:var(--fg-faint)"></span>famous</div>`
    }

    function frontierHTML() {
      const rows = frontier.slice(0, 150).map((f: any) =>
        `<li><span class="pid">${f.d}</span><div><a class="prob" href="#/p/${f.i}"><h2>${esc(f.t)}</h2></a></div></li>`).join('')
      return `<div class="op-domain-head"><h1>The frontier</h1><div class="n">the most recently stated open problems — what humanity just realized it doesn't know.</div></div>
      <ol class="op-rows">${rows}</ol>`
    }

    async function initAtlas() {
      const pts = await atlas()
      const cv = document.getElementById('op-atlas') as HTMLCanvasElement
      if (!cv) return
      const tip = document.getElementById('op-atlas-tip')!
      const dpr = window.devicePixelRatio || 1
      let scale = Math.min(cv.clientWidth, cv.clientHeight) * 0.46, ox = 0.5, oy = 0.5, tx = 0, ty = 0
      const resize = () => {
        cv.width = cv.clientWidth * dpr; cv.height = cv.clientHeight * dpr
      }
      resize(); window.addEventListener('resize', resize)
      let hover: any = null
      function draw() {
        const ctx = cv.getContext('2d')!
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
        ctx.fillStyle = getComputedStyle(document.body).getPropertyValue('--bg') || '#fff'
        ctx.fillRect(0, 0, cv.clientWidth, cv.clientHeight)
        const cx = cv.clientWidth * ox + tx, cy = cv.clientHeight * oy + ty
        for (const p of pts) {
          const x = cx + p.x * scale, y = cy + p.y * scale
          if (x < -8 || y < -8 || x > cv.clientWidth + 8 || y > cv.clientHeight + 8) continue
          const bright = (1 - p.f / 9) * (0.4 + 0.6 * Math.min(1, p.b / 6))
          ctx.fillStyle = `rgba(17,17,17,${(0.18 + 0.72 * bright).toFixed(2)})`
          const r = p === hover ? 3 : 1.15 + (p.b > 3 ? 0.5 : 0)
          ctx.beginPath(); ctx.arc(x, y, r, 0, 6.2832); ctx.fill()
        }
      }
      draw()
      let dragging = false, lx = 0, ly = 0
      cv.addEventListener('mousedown', (e) => { dragging = true; lx = e.clientX; ly = e.clientY })
      window.addEventListener('mouseup', () => (dragging = false))
      cv.addEventListener('mousemove', (e) => {
        if (dragging) { tx += e.clientX - lx; ty += e.clientY - ly; lx = e.clientX; ly = e.clientY; draw(); return }
        const rect = cv.getBoundingClientRect()
        const mx = e.clientX - rect.left, my = e.clientY - rect.top
        const cx = cv.clientWidth * ox + tx, cy = cv.clientHeight * oy + ty
        hover = null
        for (const p of pts) {
          const x = cx + p.x * scale, y = cy + p.y * scale
          if ((x - mx) ** 2 + (y - my) ** 2 < 25) { hover = p; break }
        }
        if (hover) {
          tip.style.display = 'block'
          tip.style.left = (mx + 12) + 'px'; tip.style.top = (my - 8) + 'px'
          tip.textContent = `${hover.t} · ${hover.d}`
          cv.style.cursor = 'pointer'
        } else { tip.style.display = 'none'; cv.style.cursor = 'crosshair' }
        draw()
      })
      cv.addEventListener('click', () => { if (hover) location.hash = '#/p/' + hover.i })
      cv.addEventListener('wheel', (e) => {
        e.preventDefault()
        scale *= e.deltaY < 0 ? 1.12 : 0.89
        scale = Math.max(40, Math.min(40000, scale))
        draw()
      }, { passive: false })
    }

    async function route() {
      const h = location.hash || '#/'
      window.scrollTo({ top: 0 })
      if (h.startsWith('#/p/')) {
        const id = decodeURIComponent(h.slice(4))
        crumb.innerHTML = `<a href="#/">problems</a><span class="sep">/</span><a href="#/d/${idsToDom[id] || ''}">${esc(idsToDom[id] || '—')}</a>`
        view.innerHTML = await problemHTML(id)
      } else if (h === '#/atlas') {
        crumb.innerHTML = `<a href="#/">problems</a><span class="sep">/</span>atlas`
        view.innerHTML = await atlasHTML()
        initAtlas()
      } else if (h === '#/frontier') {
        crumb.innerHTML = `<a href="#/">problems</a><span class="sep">/</span>frontier`
        view.innerHTML = frontierHTML()
      } else if (h === '#/famous') {
        crumb.innerHTML = `<a href="#/">problems</a><span class="sep">/</span>the famous ones`
        view.innerHTML = await famousHTML()
      } else if (h.startsWith('#/d/')) {
        const slug = decodeURIComponent(h.slice(4))
        crumb.innerHTML = `<a href="#/">problems</a><span class="sep">/</span>${esc(slug)}`
        view.innerHTML = await domainHTML(slug)
      } else {
        crumb.innerHTML = ''
        view.innerHTML = homeHTML()
        const inp = document.getElementById('op-search') as HTMLInputElement
        inp.addEventListener('input', () => runSearch(inp.value))
      }
      typeset(view)
    }
    window.addEventListener('hashchange', route)
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && !/input|textarea/i.test((e.target as HTMLElement).tagName || '')) {
        const inp = document.getElementById('op-search') as HTMLInputElement
        if (inp) { e.preventDefault(); inp.focus() }
      }
    })
    route()
  </script>
</Base>
