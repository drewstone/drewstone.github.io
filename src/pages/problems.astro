---
import Base from '../layouts/Base.astro'
---

<Base
  title="Open problems"
  description="A living census of unsolved problems across mathematics, computer science, cryptography, the sciences, and engineering — with linked citations, status, and significance."
  wide={true}
>
  <h1>Open problems</h1>
  <p class="problems-meta">
    A living census of unsolved problems — mathematics, computer science,
    cryptography, the sciences, engineering. Every record carries linked
    citations, provenance, and status checked against citing literature. Built
    with agent pipelines over curated lists, peer-reviewed problem papers,
    maintained databases, and census sessions. Source:
    <a href="https://github.com/drewstone/openprobs">openprobs</a>.
  </p>

  <input
    id="problems-search"
    type="search"
    placeholder='search the census — "conjecture", "obfuscation", "turbulence", "Riemann"…'
    aria-label="Search problems"
  />
  <div id="problems-count" class="problems-meta"></div>
  <div id="view"></div>

  <style is:global>
    .problems-meta { color: var(--fg-muted); font-size: 0.9rem; }
    #problems-search {
      font-family: var(--font-mono); font-size: 0.85rem;
      padding: 0.35rem 0.6rem; border: 1px solid var(--border-strong);
      border-radius: var(--control-radius); width: 100%; margin: 0.6rem 0;
      background: var(--bg); color: var(--fg);
    }
    .ptable { border-collapse: collapse; width: 100%; font-size: 0.85rem; }
    .ptable th { border-bottom: 1px solid var(--rule); font-weight: 600; text-align: left; padding: 0.35rem 0.5rem; }
    .ptable td { border-bottom: 1px solid var(--border); padding: 0.35rem 0.5rem; vertical-align: top; }
    .mono { font-family: var(--font-mono); font-size: 0.78rem; color: var(--fg-muted); }
    .tag { display: inline-block; border: 1px solid; border-radius: 3px; padding: 0 0.4rem; font-size: 0.72rem; font-family: var(--font-mono); white-space: nowrap; }
    .tag-sig { color: var(--c-run); border-color: #f59e0b; background: var(--c-run-bg); }
    .tag-solved { color: var(--c-fail); border-color: #f87171; background: var(--c-fail-bg); }
    .tag-domain { color: var(--c-info); border-color: #93c5fd; background: var(--c-info-bg); }
    .tag-type { color: var(--fg-muted); border-color: var(--border-strong); background: var(--bg-alt); }
    .dom-card { display: block; padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--border); cursor: pointer; }
    .dom-card:hover { background: var(--bg-alt); }
    .dom-card .n { font-family: var(--font-mono); font-size: 0.8rem; color: var(--fg-muted); float: right; }
    .subhead { font-weight: 600; margin: 1.2rem 0 0.3rem; font-size: 1rem; }
    .prob-row { cursor: pointer; }
    .prob-row:hover { background: var(--bg-alt); }
    .detail h2 { margin: 0.2rem 0 0.6rem; }
    .detail .field { margin: 0.7rem 0; }
    .detail .field b { display: block; font-size: 0.78rem; font-family: var(--font-mono); color: var(--fg-faint); text-transform: lowercase; letter-spacing: 0.03em; }
    .cite { display: block; margin: 0.15rem 0; font-size: 0.85rem; }
    .backlink { font-family: var(--font-mono); font-size: 0.8rem; color: var(--fg-muted); display: inline-block; margin-bottom: 1rem; }
    .backlink:hover { color: var(--fg); }
    .btnrow { margin: 0.5rem 0; }
    .btnrow a { font-family: var(--font-mono); font-size: 0.75rem; border: 1px solid var(--border-strong); border-radius: 3px; padding: 0.1rem 0.5rem; margin-right: 0.4rem; text-decoration: none; }
    .btnrow a:hover { background: var(--bg-alt); }
    .edge { display: inline-block; margin: 0.15rem 0.3rem 0.15rem 0; }
  </style>

  <script>
    // ---------- data loading ----------
    const manifest = await fetch('/problems-data/manifest.json').then(r => r.json())
    const edges = await fetch('/problems-data/edges.json').then(r => r.json())
    const idsToDom = await fetch('/problems-data/ids.json').then(r => r.json())

    let cache = {}
    async function domain(slug) {
      if (!cache[slug]) cache[slug] = await fetch(`/problems-data/${slug}.json`).then(r => r.json())
      return cache[slug]
    }

    // ---------- helpers ----------
    const esc = (s) => { const d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML }
    const scholar = (q) => 'https://scholar.google.com/scholar?q=' + encodeURIComponent(q)

    // link-ify a citation string: arXiv / ePrint / DOI / URLs, else Scholar search
    function citeHTML(c) {
      c = c.trim(); if (!c) return ''
      let m
      if ((m = c.match(/arxiv\.org\/abs\/([0-9.]+v?\d*)/i)) || (m = c.match(/arXiv:([0-9]{4}\.[0-9]{4,5})/i)))
        return `<a class="cite" href="https://arxiv.org/abs/${m[1]}" target="_blank" rel="noopener">${esc(c)} ↗</a>`
      if ((m = c.match(/eprint\.iacr\.org\/(\d{4}\/\d+)/i)) || (m = c.match(/eprint\s*(?:\/|\s)?\s*(\d{4}\/\d+)/i)))
        return `<a class="cite" href="https://eprint.iacr.org/${m[1]}" target="_blank" rel="noopener">${esc(c)} ↗</a>`
      if ((m = c.match(/(10\.\d{4,9}\/[^\s;,)]+)/)))
        return `<a class="cite" href="https://doi.org/${m[1]}" target="_blank" rel="noopener">${esc(c)} ↗</a>`
      if ((m = c.match(/(https?:\/\/[^\s;,)]+)/)))
        return `<a class="cite" href="${m[1]}" target="_blank" rel="noopener">${esc(c)} ↗</a>`
      return `<a class="cite" href="${scholar(c)}" target="_blank" rel="noopener">${esc(c)} · scholar ↗</a>`
    }
    function citesHTML(kw) {
      if (!kw) return '<span class="mono">no recorded citations</span>'
      return kw.split(/;(?![^(]*\))/).flatMap(x => x.split(/ (?=[A-Z][a-z]+ )/)).slice(0, 12).map(citeHTML).join('')
    }

    const sigTitle = (s) =>
      s >= 5 ? 'significance: appears in prize lists and community-curated problem lists'
        : s >= 3 ? 'significance: prize-bearing or community-curated'
        : s >= 2 ? 'significance: appears in a curated list' : ''

    function problemRow(r) {
      return `<tr class="prob-row" data-id="${r.id}">
        <td class="mono">${r.id}</td>
        <td>${esc(r.title)}${r.solved ? ' <span class="tag tag-solved">solved?</span>' : ''}</td>
        <td>${r.sig >= 5 ? `<span class="tag tag-sig" title="${sigTitle(r.sig)}">★ ${r.sig}</span>` : ''}</td>
      </tr>`
    }

    async function renderDomain(slug) {
      const rows = await domain(slug)
      const bySub = new Map()
      for (const r of rows) {
        const k = r.subfield || 'general'
        if (!bySub.has(k)) bySub.set(k, [])
        bySub.get(k).push(r)
      }
      let h = `<a class="backlink" href="#/">← all domains</a>
        <h2>${esc(slug)} <span class="mono">${rows.length.toLocaleString()} problems</span></h2>`
      for (const [sub, rs] of bySub) {
        h += `<div class="subhead">${esc(sub)} <span class="mono">${rs.length}</span></div>
          <table class="ptable"><tbody>${rs.map(problemRow).join('')}</tbody></table>`
      }
      return h
    }

    async function renderProblem(id) {
      const slug = idsToDom[id]
      if (!slug) return `<a class="backlink" href="#/">← all domains</a><p class="mono">unknown id ${esc(id)}</p>`
      const rows = await domain(slug)
      const r = rows.find(x => x.id === id)
      if (!r) return `<p class="mono">not found</p>`
      const rel = edges.filter(e => e.a === id || e.b === id)
      const relLinks = rel.map(e => {
        const other = e.a === id ? e.b : e.a
        return `<a class="edge" href="#/p/${other}"><span class="tag tag-type">${e.type}</span> <span class="mono">${other}</span></a>`
      }).join('')
      const parent = r.parent ? `<a href="#/p/${r.parent.match(/[A-Z]+-\d+/)?.[0]}" class="mono">↑ parent ${esc(r.parent)}</a>` : ''
      const s2 = r.s2 ? `https://www.semanticscholar.org/paper/${r.s2.s2_id}` : null
      return `<a class="backlink" href="#/d/${slug}">← ${esc(slug)}</a>
        <div class="detail">
        <h2>${esc(r.title)} <span class="mono">${r.id}</span></h2>
        <p>${r.sig >= 3 ? `<span class="tag tag-sig" title="${sigTitle(r.sig)}">significance ${r.sig}</span>` : ''}
           ${r.type ? `<span class="tag tag-type">${esc(r.type)}</span>` : ''}
           ${r.prize ? `<span class="tag tag-sig">prize: ${esc(r.prize)}</span>` : ''}
           ${r.solved ? `<span class="tag tag-solved">solved-candidate: ${esc(r.solved.paper || '')} (${r.solved.year || ''})</span>` : ''}</p>
        <div class="field"><b>open</b>${esc(r.open)}</div>
        <div class="field"><b>status</b>${esc(r.status)}</div>
        ${r.why ? `<div class="field"><b>why it matters</b>${esc(r.why)}</div>` : ''}
        ${r.aliases ? `<div class="field"><b>aliases</b><span class="mono">${esc(r.aliases)}</span></div>` : ''}
        <div class="field"><b>citations &amp; prior work</b>${citesHTML(r.key_works)}
          <div class="btnrow">
            <a href="${scholar(r.title)}" target="_blank" rel="noopener">google scholar ↗</a>
            ${s2 ? `<a href="${s2}" target="_blank" rel="noopener">semantic scholar ↗</a>` : ''}
            <a href="https://openalex.org/works?filter=default.search%3A${encodeURIComponent(r.title)}" target="_blank" rel="noopener">openalex ↗</a>
          </div>
        </div>
        ${rel.length ? `<div class="field"><b>related problems</b>${relLinks}</div>` : ''}
        ${parent ? `<div class="field"><b>decomposition</b>${parent}</div>` : ''}
        <div class="field"><b>provenance</b><span class="mono">${esc(r.source)}</span></div>
        </div>`
    }

    function renderHome(query) {
      const q = (query || '').trim().toLowerCase()
      let h = ''
      if (q) {
        // search across all loaded domains lazily: search manifest domains in order
        h = `<div class="subhead">search results</div><table class="ptable"><tbody id="search-rows"><tr><td class="mono">searching…</td></tr></tbody></table>`
        ;(async () => {
          let hits = []
          for (const slug of Object.keys(manifest)) {
            const rows = await domain(slug)
            for (const r of rows)
              if ((r.title + ' ' + r.aliases + ' ' + r.subfield + ' ' + r.open.slice(0, 300)).toLowerCase().includes(q))
                hits.push(r)
            if (hits.length > 400) break
          }
          hits.sort((a, b) => b.sig - a.sig)
          document.getElementById('search-rows').innerHTML =
            hits.slice(0, 400).map(problemRow).join('') ||
            '<tr><td class="mono">no matches</td></tr>'
          document.getElementById('problems-count').textContent =
            `${hits.length.toLocaleString()} matches`
        })()
        return h
      }
      h += `<div class="subhead">domains</div>`
      for (const [slug, n] of Object.entries(manifest)) {
        h += `<a class="dom-card" href="#/d/${slug}">${esc(slug)}<span class="n">${n.toLocaleString()}</span></a>`
      }
      return h
    }

    // ---------- router ----------
    const view = document.getElementById('view')
    async function route() {
      const h = location.hash || '#/'
      view.querySelectorAll('.prob-row').forEach = null
      if (h.startsWith('#/p/')) {
        view.innerHTML = await renderProblem(decodeURIComponent(h.slice(4)))
      } else if (h.startsWith('#/d/')) {
        view.innerHTML = await renderDomain(decodeURIComponent(h.slice(4)))
      } else {
        view.innerHTML = renderHome(document.getElementById('problems-search').value)
      }
      document.getElementById('problems-count').textContent =
        h === '#/' && !document.getElementById('problems-search').value
          ? `${Object.values(manifest).reduce((a, b) => a + b, 0).toLocaleString()} problems · ${Object.keys(manifest).length} domains`
          : document.getElementById('problems-count').textContent
    }
    window.addEventListener('hashchange', route)
    document.getElementById('problems-search').addEventListener('input', (e) => {
      if ((location.hash || '#/') !== '#/') location.hash = '#/'
      else route()
    })
    view.addEventListener('click', (e) => {
      const tr = e.target.closest('.prob-row')
      if (tr) location.hash = '#/p/' + tr.dataset.id
    })
    route()
  </script>
</Base>
