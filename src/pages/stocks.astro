---
import Base from '../layouts/Base.astro'

const GROUPS = {
  Semiconductors: [
    ['NVDA', 'NVIDIA Corporation'],
    ['TSM', 'TSMC'],
    ['AVGO', 'Broadcom Inc.'],
    ['AMD', 'Advanced Micro Devices'],
    ['INTC', 'Intel Corporation'],
    ['QCOM', 'Qualcomm Incorporated'],
    ['TXN', 'Texas Instruments'],
    ['AMAT', 'Applied Materials'],
    ['ASML', 'ASML Holding'],
    ['LRCX', 'Lam Research'],
    ['MU', 'Micron Technology'],
    ['KLAC', 'KLA Corporation'],
    ['ADI', 'Analog Devices'],
    ['IFNNY', 'Infineon Technologies'],
    ['STM', 'STMicroelectronics'],
    ['ARM', 'Arm Holdings'],
    ['MRVL', 'Marvell Technology'],
    ['NXPI', 'NXP Semiconductors'],
    ['ON', 'ON Semiconductor'],
    ['GFS', 'GlobalFoundries'],
    ['CDNS', 'Cadence Design Systems'],
    ['SNPS', 'Synopsys Inc.'],
  ],
  Tech: [
    ['MSFT', 'Microsoft Corporation'],
    ['GOOGL', 'Alphabet Inc.'],
    ['AAPL', 'Apple Inc.'],
    ['AMZN', 'Amazon.com Inc.'],
    ['NET', 'Cloudflare Inc.'],
    ['CBRS', 'Cerebras Systems Inc.'],
  ],
}

const ALL = Object.values(GROUPS).flat()
---

<Base title="Stocks" description="Live prices for tracked tickers." wide>
  <header class="page-head">
    <p class="tag">Watchlist</p>
    <h1>Stocks</h1>
    <p class="lede">{ALL.length} names across semiconductors and tech. Refreshed every minute.</p>
    <div class="toolbar">
      <input type="search" id="filter" placeholder="Filter by symbol or name" autocomplete="off" />
      <div class="filters" role="group" aria-label="Filter by group">
        <button class="chip active" data-group="all">All</button>
        {Object.keys(GROUPS).map((g) => (
          <button class="chip" data-group={g.toLowerCase()}>{g}</button>
        ))}
      </div>
    </div>
  </header>

  <div class="table-wrap">
    <table class="stock-table">
      <thead>
        <tr>
          <th>Symbol</th>
          <th>Name</th>
          <th class="num">Price</th>
          <th class="num">Change</th>
          <th class="num">Change%</th>
          <th>Updated</th>
        </tr>
      </thead>
      <tbody id="rows">
        {ALL.map(([sym, name]) => (
          <tr
            class="stock-row"
            data-group={Object.entries(GROUPS).find(([, list]) => list.some(([s]) => s === sym))?.[0].toLowerCase()}
            data-sym={sym}
            data-name={name}
          >
            <td class="ticker">{sym}</td>
            <td class="name">{name}</td>
            <td class="num muted" colspan="3">loading…</td>
            <td class="muted">—</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="footnote">Quotes from Yahoo Finance. Not financial advice.</p>
</Base>

<script>
const ROWS = [...document.querySelectorAll('.stock-row')]
const filterInput = document.getElementById('filter')
const chips = [...document.querySelectorAll('.chip')]

function fmt(n, d = 2) {
  return n == null
    ? '—'
    : Number(n).toLocaleString('en-US', {
        minimumFractionDigits: d,
        maximumFractionDigits: d,
      })
}

async function fetchQuote(sym) {
  try {
    const r = await fetch(
      `https://query1.finance.yahoo.com/v8/finance/chart/${sym}?interval=1d&range=2d`,
    )
    if (!r.ok) throw new Error(String(r.status))
    const j = await r.json()
    const res = j.chart.result[0]
    const meta = res.meta
    const prev = res.previousClose ?? meta.chartPreviousClose
    const price = meta.regularMarketPrice
    const chg = price - prev
    const pct = (chg / prev) * 100
    return { sym, price, chg, pct, ts: meta.regularMarketTime }
  } catch (e) {
    return { sym, error: e.message }
  }
}

async function loadAll() {
  const results = await Promise.all(ROWS.map((tr) => fetchQuote(tr.dataset.sym)))n  for (const q of results) {
    const tr = document.querySelector(`.stock-row[data-sym="${q.sym}"]`)
    if (!tr) continue
    if (q.error) {
      tr.innerHTML = `<td class="ticker">${q.sym}</td><td class="name">${tr.dataset.name}</td><td class="num fail" colspan="3">unavailable</td><td class="muted">—</td>`
    } else {
      const up = q.chg >= 0
      const cls = up ? 'ok' : 'fail'
      tr.innerHTML = `<td class="ticker">${q.sym}</td><td class="name">${tr.dataset.name}</td><td class="num">${fmt(q.price)}</td><td class="num ${cls}">${up ? '+' : ''}${fmt(q.chg)}</td><td class="num ${cls}">${up ? '+' : ''}${fmt(q.pct)}%</td><td class="muted">${new Date(q.ts * 1000).toLocaleTimeString()}</td>`
    }
  }
}

function applyFilters() {
  const q = filterInput.value.trim().toLowerCase()
  const group = chips.find((c) => c.classList.contains('active'))?.dataset.group ?? 'all'
  for (const tr of ROWS) {
    const matchGroup = group === 'all' || tr.dataset.group === group
    const matchText = !q || tr.dataset.sym.toLowerCase().includes(q) || tr.dataset.name.toLowerCase().includes(q)
    tr.hidden = !(matchGroup && matchText)
  }
}

filterInput.addEventListener('input', applyFilters)
for (const chip of chips) {
  chip.addEventListener('click', () => {
    for (const c of chips) c.classList.remove('active')
    chip.classList.add('active')
    applyFilters()
  })
}

loadAll()
setInterval(loadAll, 60000)
</script>

<style>
  .page-head {
    margin-bottom: var(--space-2xl);
  }

  .lede {
    color: var(--fg-muted);
    font-size: 1.05rem;
    margin-bottom: var(--space-lg);
  }

  .toolbar {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  #filter {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    width: 100%;
    max-width: 28rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
  }

  #filter:focus {
    outline: none;
    border-color: var(--border-strong);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }

  .chip:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .chip.active {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .table-wrap {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .stock-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .stock-table th,
  .stock-table td {
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .stock-table th {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
    border-bottom: 2px solid var(--fg);
  }

  .stock-table tr:hover td {
    background: var(--bg-alt);
  }

  .ticker {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .name {
    color: var(--fg-muted);
  }

  .num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .ok {
    color: var(--c-ok);
  }

  .fail {
    color: var(--c-fail);
  }

  .muted {
    color: var(--fg-faint);
  }

  .footnote {
    margin-top: var(--space-xl);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-faint);
  }
</style>
