---
import Base from '../layouts/Base.astro'

const GROUPS = {
  Semiconductors: [
    ['NVDA', 'NVIDIA Corporation'],
    ['TSM', 'TSMC'],
    ['AVGO', 'Broadcom Inc.'],
    ['AMD', 'Advanced Micro Devices'],
    ['INTC', 'Intel Corporation'],
    ['QCOM', 'Qualcomm Incorporated'],
    ['TXN', 'Texas Instruments'],
    ['AMAT', 'Applied Materials'],
    ['ASML', 'ASML Holding'],
    ['LRCX', 'Lam Research'],
    ['MU', 'Micron Technology'],
    ['KLAC', 'KLA Corporation'],
    ['ADI', 'Analog Devices'],
    ['IFNNY', 'Infineon Technologies'],
    ['STM', 'STMicroelectronics'],
    ['ARM', 'Arm Holdings'],
    ['MRVL', 'Marvell Technology'],
    ['NXPI', 'NXP Semiconductors'],
    ['ON', 'ON Semiconductor'],
    ['GFS', 'GlobalFoundries'],
    ['CDNS', 'Cadence Design Systems'],
    ['SNPS', 'Synopsys Inc.'],
  ],
  Tech: [
    ['MSFT', 'Microsoft Corporation'],
    ['GOOGL', 'Alphabet Inc.'],
    ['AAPL', 'Apple Inc.'],
    ['AMZN', 'Amazon.com Inc.'],
    ['NET', 'Cloudflare Inc.'],
    ['CBRS', 'Cerebras Systems Inc.'],
  ],
}

const ALL = Object.values(GROUPS).flat()
---

<Base title="Stocks" description="Stocks" wide>
  <header class="page-head">
    <h1>Stocks</h1>
    <div class="toolbar">
      <input type="search" id="filter" placeholder="Filter by symbol or name" autocomplete="off" />
      <div class="toolbar-row">
        <div class="filters" role="group" aria-label="Filter by group">
          <button class="chip active" data-group="all">All</button>
          {Object.keys(GROUPS).map((g) => (
            <button class="chip" data-group={g.toLowerCase()}>{g}</button>
          ))}
        </div>
        <div class="modes">
          <button class="chip active" id="stream" type="button" aria-pressed="true">Streaming on</button>
          <button class="chip" id="refresh" type="button">Refresh</button>
        </div>
      </div>
    </div>
  </header>

  <div class="table-wrap">
    <table class="stock-table">
      <thead>
        <tr>
          <th>Symbol</th>
          <th>Name</th>
          <th class="num">Price</th>
          <th class="num">1D</th>
          <th class="num">1D%</th>
          <th class="num">30D</th>
          <th class="num">30D%</th>
          <th class="num">50D MA</th>
          <th class="num">200D MA</th>
          <th>Updated</th>
        </tr>
      </thead>
      <tbody id="rows">
        {ALL.map(([sym, name]) => (
          <tr
            class="stock-row"
            data-group={Object.entries(GROUPS).find(([, list]) => list.some(([s]) => s === sym))?.[0].toLowerCase()}
            data-sym={sym}
            data-name={name}
          >
            <td class="ticker">{sym}</td>
            <td class="name">{name}</td>
            <td class="num muted" colspan="7">loading…</td>
            <td class="muted">—</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>

<script>
const ROWS = [...document.querySelectorAll('.stock-row')]
const filterInput = document.getElementById('filter')
const chips = [...document.querySelectorAll('.filters .chip')]
const streamBtn = document.getElementById('stream')
const refreshBtn = document.getElementById('refresh')
const POLL_MS = 20000
const DAY = 24 * 60 * 60

let pollTimer = 0
let busy = false

function fmt(n) {
  return n == null || Number.isNaN(Number(n))
    ? '—'
    : Number(n).toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      })
}

function signed(n) {
  if (n == null || Number.isNaN(Number(n))) return '—'
  const text = fmt(n)
  return n > 0 ? `+${text}` : text
}

function signedPct(n) {
  const text = signed(n)
  return text === '—' ? text : `${text}%`
}

function tone(n) {
  if (n == null || Number.isNaN(Number(n))) return 'num'
  return n >= 0 ? 'num ok' : 'num fail'
}

function finite(n) {
  return typeof n === 'number' && Number.isFinite(n)
}

function mean(bars, count, key) {
  if (bars.length < count) return null
  let sum = 0
  for (let i = bars.length - count; i < bars.length; i++) sum += bars[i][key]
  return sum / count
}

function parseChart(sym, body) {
  const res = body?.chart?.result?.[0]
  const meta = res?.meta
  if (!meta) throw new Error('empty')
  const stamps = res.timestamp || []
  const quote = res.indicators?.quote?.[0]?.close || []
  const adj = res.indicators?.adjclose?.[0]?.adjclose || []
  const bars = []
  for (let i = 0; i < stamps.length; i++) {
    const close = quote[i]
    const adjusted = adj[i]
    if (!finite(close) && !finite(adjusted)) continue
    bars.push({
      t: stamps[i],
      close: finite(close) ? close : adjusted,
      adj: finite(adjusted) ? adjusted : close,
    })
  }
  if (bars.length < 2) throw new Error('short')
  const last = bars[bars.length - 1]
  const prior = bars[bars.length - 2]
  const regular = finite(meta.regularMarketPrice) ? meta.regularMarketPrice : last.close
  const price = finite(meta.fulldayPrice) ? meta.fulldayPrice : regular
  const prevClose = Math.abs(last.close - regular) > 0.02 ? last.close : prior.close
  const dayChg = price - prevClose
  const dayPct = prevClose ? (dayChg / prevClose) * 100 : null
  const factor = last.close ? last.adj / last.close : 1
  const liveAdj = price * (Number.isFinite(factor) ? factor : 1)
  const target = last.t - 30 * DAY
  let base = null
  for (let i = bars.length - 1; i >= 0; i--) {
    if (bars[i].t <= target) {
      base = bars[i]
      break
    }
  }
  const enoughHistory = base && last.t - base.t >= 20 * DAY
  const m30 = enoughHistory ? liveAdj - base.adj : null
  const m30pct = enoughHistory && base.adj ? (m30 / base.adj) * 100 : null
  return {
    sym,
    price,
    dayChg,
    dayPct,
    m30,
    m30pct,
    ma50: mean(bars, 50, 'adj'),
    ma200: mean(bars, 200, 'adj'),
    ts: (meta.regularMarketTime || last.t) * 1000,
  }
}

async function fetchQuote(sym) {
  const hosts = ['query1.finance.yahoo.com', 'query2.finance.yahoo.com']
  let error = 'unavailable'
  for (let attempt = 0; attempt < 2; attempt++) {
    for (const host of hosts) {
      const url = `https://${host}/v8/finance/chart/${encodeURIComponent(sym)}?range=1y&interval=1d&includeAdjustedClose=true`
      try {
        const r = await fetch('https://proxy.cors.dev/' + url, { cache: 'no-store' })
        if (r.status === 429) {
          error = '429'
          continue
        }
        if (!r.ok) {
          error = String(r.status)
          continue
        }
        return parseChart(sym, await r.json())
      } catch (e) {
        error = e.message || 'unavailable'
      }
    }
    if (error !== '429') break
    await new Promise((resolve) => setTimeout(resolve, 700 * (attempt + 1)))
  }
  return { sym, error }
}

function paint(tr, q) {
  tr.dataset.priced = '1'
  const when = q.ts ? new Date(q.ts).toLocaleTimeString() : '—'
  tr.innerHTML = `<td class="ticker">${tr.dataset.sym}</td><td class="name">${tr.dataset.name}</td><td class="num">${fmt(q.price)}</td><td class="${tone(q.dayChg)}">${signed(q.dayChg)}</td><td class="${tone(q.dayPct)}">${signedPct(q.dayPct)}</td><td class="${tone(q.m30)}">${signed(q.m30)}</td><td class="${tone(q.m30pct)}">${signedPct(q.m30pct)}</td><td class="num">${fmt(q.ma50)}</td><td class="num">${fmt(q.ma200)}</td><td class="muted">${when}</td>`
}

function markUnavailable(tr) {
  if (tr.dataset.priced === '1') return
  tr.innerHTML = `<td class="ticker">${tr.dataset.sym}</td><td class="name">${tr.dataset.name}</td><td class="num fail" colspan="7">unavailable</td><td class="muted">—</td>`
}

async function loadAll() {
  if (busy) return
  busy = true
  refreshBtn.disabled = true
  try {
    let cursor = 0
    async function worker() {
      while (cursor < ROWS.length) {
        const tr = ROWS[cursor++]
        const q = await fetchQuote(tr.dataset.sym)
        if (q.error) markUnavailable(tr)
        else paint(tr, q)
      }
    }
    const workers = Math.min(4, ROWS.length)
    await Promise.all(Array.from({ length: workers }, () => worker()))
  } finally {
    busy = false
    refreshBtn.disabled = false
  }
}

function setStreaming(on) {
  streamBtn.setAttribute('aria-pressed', on ? 'true' : 'false')
  streamBtn.classList.toggle('active', on)
  streamBtn.textContent = on ? 'Streaming on' : 'Streaming off'
  clearInterval(pollTimer)
  pollTimer = 0
  if (on) pollTimer = setInterval(loadAll, POLL_MS)
}

function applyFilters() {
  const q = filterInput.value.trim().toLowerCase()
  const group = chips.find((c) => c.classList.contains('active'))?.dataset.group ?? 'all'
  for (const tr of ROWS) {
    const matchGroup = group === 'all' || tr.dataset.group === group
    const matchText = !q || tr.dataset.sym.toLowerCase().includes(q) || tr.dataset.name.toLowerCase().includes(q)
    tr.hidden = !(matchGroup && matchText)
  }
}

filterInput.addEventListener('input', applyFilters)
for (const chip of chips) {
  chip.addEventListener('click', () => {
    for (const c of chips) c.classList.remove('active')
    chip.classList.add('active')
    applyFilters()
  })
}

streamBtn.addEventListener('click', () => {
  setStreaming(streamBtn.getAttribute('aria-pressed') !== 'true')
})
refreshBtn.addEventListener('click', loadAll)

setStreaming(true)
loadAll()
</script>

<style>
  .page-head {
    margin-bottom: var(--space-2xl);
  }

  .toolbar {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .toolbar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .modes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  #filter {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    width: 100%;
    max-width: 28rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
  }

  #filter:focus {
    outline: none;
    border-color: var(--border-strong);
  }

  #refresh:disabled {
    opacity: 0.55;
    cursor: default;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }

  .chip:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .chip.active {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .table-wrap {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .stock-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .stock-table th,
  .stock-table td {
    padding: 0.4rem 0.45rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .stock-table th {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg-faint);
    border-bottom: 2px solid var(--fg);
    white-space: nowrap;
  }

  .stock-table tr:hover td {
    background: var(--bg-alt);
  }

  .ticker {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .name {
    color: var(--fg-muted);
  }

  .num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .ok {
    color: var(--c-ok);
  }

  .fail {
    color: var(--c-fail);
  }

  .muted {
    color: var(--fg-faint);
    white-space: nowrap;
  }
</style>
