---
import Base from '../layouts/Base.astro'

const GROUPS = {
  Semiconductors: [
    ['NVDA', 'NVIDIA Corporation'],
    ['TSM', 'TSMC'],
    ['AVGO', 'Broadcom Inc.'],
    ['AMD', 'Advanced Micro Devices'],
    ['INTC', 'Intel Corporation'],
    ['QCOM', 'Qualcomm Incorporated'],
    ['TXN', 'Texas Instruments'],
    ['AMAT', 'Applied Materials'],
    ['ASML', 'ASML Holding'],
    ['LRCX', 'Lam Research'],
    ['MU', 'Micron Technology'],
    ['KLAC', 'KLA Corporation'],
    ['ADI', 'Analog Devices'],
    ['IFNNY', 'Infineon Technologies'],
    ['STM', 'STMicroelectronics'],
    ['ARM', 'Arm Holdings'],
    ['MRVL', 'Marvell Technology'],
    ['NXPI', 'NXP Semiconductors'],
    ['ON', 'ON Semiconductor'],
    ['GFS', 'GlobalFoundries'],
    ['CDNS', 'Cadence Design Systems'],
    ['SNPS', 'Synopsys Inc.'],
  ],
  Tech: [
    ['MSFT', 'Microsoft Corporation'],
    ['GOOGL', 'Alphabet Inc.'],
    ['AAPL', 'Apple Inc.'],
    ['AMZN', 'Amazon.com Inc.'],
    ['NET', 'Cloudflare Inc.'],
    ['CBRS', 'Cerebras Systems Inc.'],
  ],
}

const ALL = Object.values(GROUPS).flat()
---

<Base title="Stocks" description="Stocks" wide>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
  />
  <div class="board">
    <header class="page-head">
      <h1>Stocks</h1>
      <div class="toolbar">
        <input type="search" id="filter" placeholder="Filter by symbol or name" autocomplete="off" />
        <div class="toolbar-row">
          <div class="filters" role="group" aria-label="Filter by group">
            <button class="chip active" data-group="all" type="button">All</button>
            {Object.keys(GROUPS).map((g) => (
              <button class="chip" type="button" data-group={g.toLowerCase()}>{g}</button>
            ))}
          </div>
          <div class="toolbar-actions">
            <div class="views" role="group" aria-label="Layout">
              <button class="chip active" id="view-table" type="button" aria-pressed="true">Table</button>
              <button class="chip" id="view-cards" type="button" aria-pressed="false">Cards</button>
            </div>
            <div class="modes">
              <button class="chip active" id="stream" type="button" aria-pressed="true">Streaming on</button>
              <button class="chip" id="refresh" type="button">Refresh</button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <section id="detail" class="detail" hidden>
      <div class="detail-top">
        <div>
          <h2 class="detail-sym" id="detail-sym"></h2>
          <p class="detail-name" id="detail-name"></p>
        </div>
        <button class="chip" id="detail-close" type="button">Close</button>
      </div>
      <div class="detail-stats" id="detail-stats"></div>
      <div class="detail-chart" id="detail-chart"></div>
      <div class="legend">
        <span><i class="swatch price"></i>Price</span>
        <span><i class="swatch ma50"></i>50D</span>
        <span><i class="swatch ma200"></i>200D</span>
        <span class="readout" id="detail-readout"></span>
      </div>
    </section>

    <div id="table-view">
      <div class="table-wrap">
        <table class="stock-table">
          <thead>
            <tr>
              <th>Symbol</th>
              <th>Name</th>
              <th>1Y</th>
              <th class="num">Price</th>
              <th class="num">1D</th>
              <th class="num">1D%</th>
              <th class="num">30D</th>
              <th class="num">30D%</th>
              <th class="num">50D MA</th>
              <th class="num">200D MA</th>
              <th>Updated</th>
            </tr>
          </thead>
          <tbody id="rows">
            {ALL.map(([sym, name]) => (
              <tr
                class="stock-row"
                tabindex="0"
                data-group={Object.entries(GROUPS).find(([, list]) => list.some(([s]) => s === sym))?.[0].toLowerCase()}
                data-sym={sym}
                data-name={name}
              >
                <td class="ticker">{sym}</td>
                <td class="name">{name}</td>
                <td class="spark" data-spark></td>
                <td class="num price">—</td>
                <td class="num d1">—</td>
                <td class="num d1p"><span class="chg">—</span></td>
                <td class="num d30">—</td>
                <td class="num d30p">—</td>
                <td class="num ma50">—</td>
                <td class="num ma200">—</td>
                <td class="muted when">—</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div id="card-view" class="card-grid" hidden>
      {ALL.map(([sym, name]) => (
        <button
          class="card"
          type="button"
          data-group={Object.entries(GROUPS).find(([, list]) => list.some(([s]) => s === sym))?.[0].toLowerCase()}
          data-sym={sym}
          data-name={name}
        >
          <div class="card-top">
            <span class="ticker">{sym}</span>
            <span class="spark" data-spark></span>
          </div>
          <div class="name">{name}</div>
          <div class="num price card-price">—</div>
          <div class="card-metrics">
            <span class="k">1D</span>
            <span class="num d1">—</span>
            <span class="num d1p"><span class="chg">—</span></span>
            <span class="k">30D</span>
            <span class="num d30">—</span>
            <span class="num d30p">—</span>
            <span class="k">50D</span>
            <span class="num ma50">—</span>
            <span></span>
            <span class="k">200D</span>
            <span class="num ma200">—</span>
            <span></span>
          </div>
          <div class="muted when">—</div>
        </button>
      ))}
    </div>
  </div>
</Base>

<script>
const ROWS = [...document.querySelectorAll('tr.stock-row')]
const filterInput = document.getElementById('filter')
const chips = [...document.querySelectorAll('.filters .chip')]
const streamBtn = document.getElementById('stream')
const refreshBtn = document.getElementById('refresh')
const tableView = document.getElementById('table-view')
const cardView = document.getElementById('card-view')
const viewTable = document.getElementById('view-table')
const viewCards = document.getElementById('view-cards')
const detail = document.getElementById('detail')
const detailChart = document.getElementById('detail-chart')
const detailReadout = document.getElementById('detail-readout')
const POLL_MS = 20000
const DAY = 24 * 60 * 60
const BOOKS = new Map()

let pollTimer = 0
let busy = false
let selected = null
let chartState = null

function fmt(n) {
  return n == null || Number.isNaN(Number(n))
    ? '—'
    : Number(n).toLocaleString('en-US', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      })
}

function signed(n) {
  if (n == null || Number.isNaN(Number(n))) return '—'
  const text = fmt(n)
  return n > 0 ? `+${text}` : text
}

function signedPct(n) {
  const text = signed(n)
  return text === '—' ? text : `${text}%`
}

function finite(n) {
  return typeof n === 'number' && Number.isFinite(n)
}

function delay(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms))
}

function mean(bars, count, key) {
  if (bars.length < count) return null
  let sum = 0
  for (let i = bars.length - count; i < bars.length; i++) sum += bars[i][key]
  return sum / count
}

function rolling(values, count) {
  const out = new Array(values.length).fill(null)
  let sum = 0
  for (let i = 0; i < values.length; i++) {
    sum += values[i]
    if (i >= count) sum -= values[i - count]
    if (i >= count - 1) out[i] = sum / count
  }
  return out
}

function parseChart(sym, body) {
  const res = body?.chart?.result?.[0]
  const meta = res?.meta
  if (!meta) throw new Error('empty')
  const stamps = res.timestamp || []
  const quote = res.indicators?.quote?.[0]?.close || []
  const adj = res.indicators?.adjclose?.[0]?.adjclose || []
  const bars = []
  for (let i = 0; i < stamps.length; i++) {
    const close = quote[i]
    const adjusted = adj[i]
    if (!finite(close) && !finite(adjusted)) continue
    bars.push({
      t: stamps[i],
      close: finite(close) ? close : adjusted,
      adj: finite(adjusted) ? adjusted : close,
    })
  }
  if (bars.length < 2) throw new Error('short')
  const last = bars[bars.length - 1]
  const prior = bars[bars.length - 2]
  const regular = finite(meta.regularMarketPrice) ? meta.regularMarketPrice : last.close
  const price = finite(meta.fulldayPrice) ? meta.fulldayPrice : regular
  const prevClose = Math.abs(last.close - regular) > 0.02 ? last.close : prior.close
  const dayChg = price - prevClose
  const dayPct = prevClose ? (dayChg / prevClose) * 100 : null
  const factor = last.close ? last.adj / last.close : 1
  const liveAdj = price * (Number.isFinite(factor) ? factor : 1)
  const target = last.t - 30 * DAY
  let base = null
  for (let i = bars.length - 1; i >= 0; i--) {
    if (bars[i].t <= target) {
      base = bars[i]
      break
    }
  }
  const enoughHistory = base && last.t - base.t >= 20 * DAY
  const m30 = enoughHistory ? liveAdj - base.adj : null
  const m30pct = enoughHistory && base.adj ? (m30 / base.adj) * 100 : null
  return {
    sym,
    name: meta.shortName || meta.longName || '',
    price,
    dayChg,
    dayPct,
    m30,
    m30pct,
    ma50: mean(bars, 50, 'adj'),
    ma200: mean(bars, 200, 'adj'),
    ts: (meta.regularMarketTime || last.t) * 1000,
    bars,
  }
}

async function readChart(url) {
  const loaders = [
    async () => {
      const r = await fetch('https://proxy.cors.dev/' + url, {
        cache: 'no-store',
        credentials: 'omit',
        signal: AbortSignal.timeout(12000),
      })
      if (!r.ok) {
        const err = new Error(String(r.status))
        err.retry = r.status === 429 || r.status >= 500
        throw err
      }
      return r.json()
    },
    async () => {
      const r = await fetch('https://api.allorigins.win/get?url=' + encodeURIComponent(url), {
        cache: 'no-store',
        credentials: 'omit',
        signal: AbortSignal.timeout(12000),
      })
      if (!r.ok) {
        const err = new Error(String(r.status))
        err.retry = r.status === 429 || r.status >= 500
        throw err
      }
      const wrapped = await r.json()
      const code = wrapped?.status?.http_code
      if (code && code >= 400) {
        const err = new Error(String(code))
        err.retry = code === 429 || code >= 500
        throw err
      }
      const contents = wrapped?.contents
      if (contents == null) throw new Error('empty proxy')
      return typeof contents === 'string' ? JSON.parse(contents) : contents
    },
  ]
  let error = 'unavailable'
  for (const load of loaders) {
    try {
      return { body: await load() }
    } catch (e) {
      error = e.message || 'unavailable'
      if (e.retry === false) break
    }
  }
  return { error }
}

async function fetchQuote(sym) {
  const hosts = ['query1.finance.yahoo.com', 'query2.finance.yahoo.com']
  let error = 'unavailable'
  for (let attempt = 0; attempt < 2; attempt++) {
    for (const host of hosts) {
      const url = `https://${host}/v8/finance/chart/${encodeURIComponent(sym)}?range=1y&interval=1d&includeAdjustedClose=true`
      const result = await readChart(url)
      if (result.body) {
        try {
          return parseChart(sym, result.body)
        } catch (e) {
          error = e.message || 'unavailable'
          continue
        }
      }
      error = result.error || error
    }
    if (attempt === 0) await delay(400)
  }
  return { sym, error }
}

function setTone(el, n) {
  el.classList.remove('ok', 'fail')
  if (n == null || Number.isNaN(Number(n))) return
  el.classList.add(n >= 0 ? 'ok' : 'fail')
}

function sparkSvg(bars) {
  const values = bars.map((bar) => bar.adj).filter(finite)
  if (values.length < 2) return ''
  const maxPoints = 56
  const pts = []
  if (values.length <= maxPoints) pts.push(...values)
  else {
    const step = (values.length - 1) / (maxPoints - 1)
    for (let i = 0; i < maxPoints; i++) pts.push(values[Math.round(i * step)])
  }
  const w = 104
  const h = 34
  const min = Math.min(...pts)
  const max = Math.max(...pts)
  const span = max - min || 1
  const points = pts
    .map((v, i) => {
      const x = (i / (pts.length - 1)) * (w - 2) + 1
      const y = (1 - (v - min) / span) * (h - 6) + 3
      return `${x.toFixed(1)},${y.toFixed(1)}`
    })
    .join(' ')
  const up = pts[pts.length - 1] >= pts[0]
  const color = up ? '#3dd68c' : '#ff5d6c'
  return `<svg class="sparkline" viewBox="0 0 ${w} ${h}" width="${w}" height="${h}" aria-hidden="true"><polyline fill="none" stroke="${color}" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" points="${points}"/></svg>`
}

function fill(node, q) {
  node.dataset.priced = '1'
  const price = node.querySelector('.price')
  if (price) price.textContent = fmt(q.price)
  const pairs = [
    ['.d1', signed(q.dayChg), q.dayChg],
    ['.d1p', signedPct(q.dayPct), q.dayPct],
    ['.d30', signed(q.m30), q.m30],
    ['.d30p', signedPct(q.m30pct), q.m30pct],
  ]
  for (const [sel, text, n] of pairs) {
    const el = node.querySelector(sel)
    if (!el) continue
    const chip = el.querySelector('.chg')
    const target = chip || el
    target.textContent = text
    setTone(target, n)
  }
  const ma50 = node.querySelector('.ma50')
  const ma200 = node.querySelector('.ma200')
  const when = node.querySelector('.when')
  const spark = node.querySelector('[data-spark]')
  if (ma50) ma50.textContent = fmt(q.ma50)
  if (ma200) ma200.textContent = fmt(q.ma200)
  if (when) when.textContent = q.ts ? new Date(q.ts).toLocaleTimeString() : '—'
  if (spark) spark.innerHTML = sparkSvg(q.bars)
}

function paint(q) {
  BOOKS.set(q.sym, q)
  for (const node of document.querySelectorAll(`[data-sym="${CSS.escape(q.sym)}"]`)) fill(node, q)
  if (selected === q.sym) renderDetail(q)
}

function markUnavailable(sym) {
  for (const node of document.querySelectorAll(`[data-sym="${CSS.escape(sym)}"]`)) {
    if (node.dataset.priced === '1') continue
    const price = node.querySelector('.price')
    if (!price) continue
    price.textContent = 'unavailable'
    price.classList.add('fail')
  }
}

async function loadAll() {
  if (busy) return
  busy = true
  refreshBtn.disabled = true
  const failed = []
  try {
    let cursor = 0
    async function worker() {
      while (cursor < ROWS.length) {
        const tr = ROWS[cursor++]
        const q = await fetchQuote(tr.dataset.sym)
        if (q.error) failed.push(tr.dataset.sym)
        else paint(q)
      }
    }
    await Promise.all(Array.from({ length: 1 }, () => worker()))
    for (const sym of failed) {
      if (document.querySelector(`tr.stock-row[data-sym="${CSS.escape(sym)}"]`)?.dataset.priced === '1') continue
      await delay(600)
      const q = await fetchQuote(sym)
      if (q.error) markUnavailable(sym)
      else paint(q)
    }
  } finally {
    busy = false
    refreshBtn.disabled = false
  }
}

function linePoints(values, plot, min, max) {
  const span = max - min || 1
  const parts = []
  let open = false
  values.forEach((v, i) => {
    if (!finite(v)) {
      open = false
      return
    }
    const x = plot.l + (i / Math.max(values.length - 1, 1)) * plot.w
    const y = plot.t + (1 - (v - min) / span) * plot.h
    parts.push(`${open ? 'L' : 'M'}${x.toFixed(2)} ${y.toFixed(2)}`)
    open = true
  })
  return parts.join(' ')
}

function renderDetail(q) {
  detail.hidden = false
  document.getElementById('detail-sym').textContent = q.sym
  document.getElementById('detail-name').textContent = q.name || document.querySelector(`[data-sym="${CSS.escape(q.sym)}"]`)?.dataset.name || ''
  document.getElementById('detail-stats').innerHTML = [
    `<span class="stat"><b class="num">${fmt(q.price)}</b></span>`,
    `<span class="stat">1D <b class="num ${q.dayChg >= 0 ? 'ok' : 'fail'}">${signed(q.dayChg)} ${signedPct(q.dayPct)}</b></span>`,
    `<span class="stat">30D <b class="num ${q.m30 == null ? '' : q.m30 >= 0 ? 'ok' : 'fail'}">${signed(q.m30)} ${signedPct(q.m30pct)}</b></span>`,
    `<span class="stat">50D <b class="num">${fmt(q.ma50)}</b></span>`,
    `<span class="stat">200D <b class="num">${fmt(q.ma200)}</b></span>`,
  ].join('')

  const values = q.bars.map((bar) => bar.adj)
  const ma50 = rolling(values, 50)
  const ma200 = rolling(values, 200)
  const finiteVals = [...values, ...ma50, ...ma200].filter(finite)
  const min = Math.min(...finiteVals)
  const max = Math.max(...finiteVals)
  const pad = (max - min || 1) * 0.08
  const y0 = min - pad
  const y1 = max + pad
  const plot = { l: 12, t: 16, w: 620, h: 236 }
  const vb = { w: 720, h: 280 }
  const ticks = 4
  let grid = ''
  let labels = ''
  for (let i = 0; i <= ticks; i++) {
    const value = y0 + ((y1 - y0) * i) / ticks
    const y = plot.t + (1 - i / ticks) * plot.h
    grid += `<line x1="${plot.l}" y1="${y.toFixed(1)}" x2="${plot.l + plot.w}" y2="${y.toFixed(1)}" stroke="rgba(231,236,243,0.08)" />`
    labels += `<text x="${plot.l + plot.w + 8}" y="${(y + 4).toFixed(1)}" fill="#8b97a8" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">${fmt(value)}</text>`
  }
  const start = new Date(q.bars[0].t * 1000).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  const end = new Date(q.bars[q.bars.length - 1].t * 1000).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  chartState = { q, values, ma50, ma200, y0, y1, plot }
  detailChart.innerHTML = `<svg class="chart" viewBox="0 0 ${vb.w} ${vb.h}" role="img" aria-label="${q.sym} one year adjusted price with moving averages">
    ${grid}
    <path d="${linePoints(ma200, plot, y0, y1)}" fill="none" stroke="#7eb6ff" stroke-width="1.4" />
    <path d="${linePoints(ma50, plot, y0, y1)}" fill="none" stroke="#e2c07a" stroke-width="1.4" />
    <path d="${linePoints(values, plot, y0, y1)}" fill="none" stroke="#f4f7fb" stroke-width="1.7" />
    <line class="cursor-line" x1="0" y1="${plot.t}" x2="0" y2="${plot.t + plot.h}" stroke="rgba(244,247,251,0.45)" visibility="hidden" />
    ${labels}
    <text x="${plot.l}" y="${vb.h - 6}" fill="#8b97a8" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace">${start}</text>
    <text x="${plot.l + plot.w}" y="${vb.h - 6}" fill="#8b97a8" font-size="11" font-family="IBM Plex Mono, ui-monospace, monospace" text-anchor="end">${end}</text>
  </svg>`
  const last = values.length - 1
  detailReadout.textContent = readoutAt(last)
}

function readoutAt(index) {
  if (!chartState) return ''
  const { q, values, ma50, ma200 } = chartState
  const i = Math.max(0, Math.min(values.length - 1, index))
  const when = new Date(q.bars[i].t * 1000).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  })
  const bits = [`${when}`, fmt(values[i])]
  if (finite(ma50[i])) bits.push(`50D ${fmt(ma50[i])}`)
  if (finite(ma200[i])) bits.push(`200D ${fmt(ma200[i])}`)
  return bits.join('  ')
}

function moveCursor(event) {
  if (!chartState) return
  const svg = detailChart.querySelector('svg')
  if (!svg) return
  const point = svg.createSVGPoint()
  point.x = event.clientX
  point.y = event.clientY
  const ctm = svg.getScreenCTM()
  if (!ctm) return
  const local = point.matrixTransform(ctm.inverse())
  const { plot, values } = chartState
  const ratio = (local.x - plot.l) / plot.w
  if (ratio < 0 || ratio > 1) return
  const index = Math.round(ratio * (values.length - 1))
  const x = plot.l + (index / Math.max(values.length - 1, 1)) * plot.w
  const line = svg.querySelector('.cursor-line')
  if (line) {
    line.setAttribute('x1', x.toFixed(2))
    line.setAttribute('x2', x.toFixed(2))
    line.setAttribute('visibility', 'visible')
  }
  detailReadout.textContent = readoutAt(index)
}

function selectSymbol(sym) {
  if (selected === sym) {
    clearSelection()
    return
  }
  selected = sym
  for (const node of document.querySelectorAll('.is-selected')) node.classList.remove('is-selected')
  for (const node of document.querySelectorAll(`[data-sym="${CSS.escape(sym)}"]`)) node.classList.add('is-selected')
  const q = BOOKS.get(sym)
  if (q) renderDetail(q)
  else {
    detail.hidden = false
    document.getElementById('detail-sym').textContent = sym
    document.getElementById('detail-name').textContent = document.querySelector(`[data-sym="${CSS.escape(sym)}"]`)?.dataset.name || ''
    document.getElementById('detail-stats').textContent = ''
    detailChart.innerHTML = ''
    detailReadout.textContent = ''
    chartState = null
  }
  detail.scrollIntoView({ block: 'nearest', behavior: 'smooth' })
}

function clearSelection() {
  selected = null
  chartState = null
  detail.hidden = true
  for (const node of document.querySelectorAll('.is-selected')) node.classList.remove('is-selected')
}

function setStreaming(on) {
  streamBtn.setAttribute('aria-pressed', on ? 'true' : 'false')
  streamBtn.classList.toggle('active', on)
  streamBtn.textContent = on ? 'Streaming on' : 'Streaming off'
  clearInterval(pollTimer)
  pollTimer = 0
  if (on) pollTimer = setInterval(loadAll, POLL_MS)
}

function setView(cards) {
  tableView.hidden = cards
  cardView.hidden = !cards
  viewTable.classList.toggle('active', !cards)
  viewCards.classList.toggle('active', cards)
  viewTable.setAttribute('aria-pressed', cards ? 'false' : 'true')
  viewCards.setAttribute('aria-pressed', cards ? 'true' : 'false')
}

function applyFilters() {
  const q = filterInput.value.trim().toLowerCase()
  const group = chips.find((c) => c.classList.contains('active'))?.dataset.group ?? 'all'
  for (const node of document.querySelectorAll('tr.stock-row, button.card')) {
    const matchGroup = group === 'all' || node.dataset.group === group
    const matchText = !q || node.dataset.sym.toLowerCase().includes(q) || node.dataset.name.toLowerCase().includes(q)
    node.hidden = !(matchGroup && matchText)
  }
}

filterInput.addEventListener('input', applyFilters)
for (const chip of chips) {
  chip.addEventListener('click', () => {
    for (const c of chips) c.classList.remove('active')
    chip.classList.add('active')
    applyFilters()
  })
}

streamBtn.addEventListener('click', () => {
  setStreaming(streamBtn.getAttribute('aria-pressed') !== 'true')
})
refreshBtn.addEventListener('click', loadAll)
viewTable.addEventListener('click', () => setView(false))
viewCards.addEventListener('click', () => setView(true))
document.getElementById('detail-close').addEventListener('click', clearSelection)
detailChart.addEventListener('pointermove', moveCursor)
detailChart.addEventListener('pointerleave', () => {
  const line = detailChart.querySelector('.cursor-line')
  if (line) line.setAttribute('visibility', 'hidden')
  if (chartState) detailReadout.textContent = readoutAt(chartState.values.length - 1)
})

for (const row of ROWS) {
  row.addEventListener('click', () => selectSymbol(row.dataset.sym))
  row.addEventListener('keydown', (event) => {
    if (event.key === 'Enter' || event.key === ' ') {
      event.preventDefault()
      selectSymbol(row.dataset.sym)
    }
  })
}
for (const card of document.querySelectorAll('button.card')) {
  card.addEventListener('click', () => selectSymbol(card.dataset.sym))
}

setStreaming(true)
loadAll()
</script>

