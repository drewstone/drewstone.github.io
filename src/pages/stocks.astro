---
import Base from '../layouts/Base.astro'

const GROUPS = {
  Semiconductors: [
    ['NVDA', 'NVIDIA Corporation'],
    ['TSM', 'TSMC'],
    ['AVGO', 'Broadcom Inc.'],
    ['AMD', 'Advanced Micro Devices'],
    ['INTC', 'Intel Corporation'],
    ['QCOM', 'Qualcomm Incorporated'],
    ['TXN', 'Texas Instruments'],
    ['AMAT', 'Applied Materials'],
    ['ASML', 'ASML Holding'],
    ['LRCX', 'Lam Research'],
    ['MU', 'Micron Technology'],
    ['KLAC', 'KLA Corporation'],
    ['ADI', 'Analog Devices'],
    ['IFNNY', 'Infineon Technologies'],
    ['STM', 'STMicroelectronics'],
    ['ARM', 'Arm Holdings'],
    ['MRVL', 'Marvell Technology'],
    ['NXPI', 'NXP Semiconductors'],
    ['ON', 'ON Semiconductor'],
    ['GFS', 'GlobalFoundries'],
    ['CDNS', 'Cadence Design Systems'],
    ['SNPS', 'Synopsys Inc.'],
  ],
  Tech: [
    ['MSFT', 'Microsoft Corporation'],
    ['GOOGL', 'Alphabet Inc.'],
    ['AAPL', 'Apple Inc.'],
    ['AMZN', 'Amazon.com Inc.'],
    ['NET', 'Cloudflare Inc.'],
    ['CBRS', 'Cerebras Systems Inc.'],
  ],
}

const ALL = Object.values(GROUPS).flat()
---

<Base title="Stocks" description="Stocks" wide>
  <header class="page-head">
    <h1>Stocks</h1>
    <div class="toolbar">
      <input type="search" id="filter" placeholder="Filter by symbol or name" autocomplete="off" />
      <div class="toolbar-row">
        <div class="filters" role="group" aria-label="Filter by group">
          <button class="chip active" data-group="all">All</button>
          {Object.keys(GROUPS).map((g) => (
            <button class="chip" data-group={g.toLowerCase()}>{g}</button>
          ))}
        </div>
        <button class="chip active" id="stream" type="button" aria-pressed="true">Live</button>
      </div>
    </div>
  </header>

  <div class="table-wrap">
    <table class="stock-table">
      <thead>
        <tr>
          <th>Symbol</th>
          <th>Name</th>
          <th class="num">Price</th>
          <th class="num">Change</th>
          <th class="num">Change%</th>
          <th>Updated</th>
        </tr>
      </thead>
      <tbody id="rows">
        {ALL.map(([sym, name]) => (
          <tr
            class="stock-row"
            data-group={Object.entries(GROUPS).find(([, list]) => list.some(([s]) => s === sym))?.[0].toLowerCase()}
            data-sym={sym}
            data-name={name}
          >
            <td class="ticker">{sym}</td>
            <td class="name">{name}</td>
            <td class="num muted" colspan="3">loading…</td>
            <td class="muted">—</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

</Base>

<script>
const ROWS = [...document.querySelectorAll('.stock-row')]
const filterInput = document.getElementById('filter')
const chips = [...document.querySelectorAll('.filters .chip')]
const streamBtn = document.getElementById('stream')
const CHART_QUERY = 'range=1d&interval=1d&includePrePost=true'
const STREAM_URL = 'wss://streamer.finance.yahoo.com/?version=2'

let socket = null
let streamOn = true
let reconnectTimer = 0
let heartbeatTimer = 0

function fmt(n, d = 2) {
  return n == null || Number.isNaN(Number(n))
    ? '—'
    : Number(n).toLocaleString('en-US', {
        minimumFractionDigits: d,
        maximumFractionDigits: d,
      })
}

function readVarint(bytes, index) {
  let result = 0n
  let shift = 0n
  let i = index
  while (i < bytes.length) {
    const b = bytes[i++]
    result |= BigInt(b & 0x7f) << shift
    if ((b & 0x80) === 0) return [result, i]
    shift += 7n
  }
  return [result, i]
}

function decodePricing(b64) {
  const bin = atob(b64)
  const bytes = new Uint8Array(bin.length)
  for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i)
  const view = new DataView(bytes.buffer)
  const out = {}
  let i = 0
  while (i < bytes.length) {
    const [tag, next] = readVarint(bytes, i)
    i = next
    const field = Number(tag >> 3n)
    const wt = Number(tag & 7n)
    if (wt === 0) {
      const [v, after] = readVarint(bytes, i)
      i = after
      if (field === 3) out.ts = Number((v >> 1n) ^ -(v & 1n))
    } else if (wt === 5) {
      const value = view.getFloat32(i, true)
      i += 4
      if (field === 2) out.price = value
      else if (field === 12) out.regChg = value
      else if (field === 8) out.regPct = value
      else if (field === 46) out.chg = value
      else if (field === 47) out.pct = value
    } else if (wt === 1) {
      i += 8
    } else if (wt === 2) {
      const [len, after] = readVarint(bytes, i)
      i = after
      const n = Number(len)
      if (field === 1) out.sym = new TextDecoder().decode(bytes.subarray(i, i + n))
      i += n
    } else {
      break
    }
  }
  return out
}

function paint(tr, q) {
  const have = Number(tr.dataset.ts || 0)
  if (have && q.ts && q.ts < have) return
  const up = q.chg >= 0
  const cls = up ? 'ok' : 'fail'
  tr.dataset.priced = '1'
  if (q.prev != null) tr.dataset.prev = String(q.prev)
  if (q.ts) tr.dataset.ts = String(q.ts)
  const when = q.ts ? new Date(q.ts).toLocaleTimeString() : '—'
  tr.innerHTML = `<td class="ticker">${tr.dataset.sym}</td><td class="name">${tr.dataset.name}</td><td class="num">${fmt(q.price)}</td><td class="num ${cls}">${up ? '+' : ''}${fmt(q.chg)}</td><td class="num ${cls}">${up ? '+' : ''}${fmt(q.pct)}%</td><td class="muted">${when}</td>`
}

function markUnavailable(tr) {
  if (tr.dataset.priced === '1') return
  tr.innerHTML = `<td class="ticker">${tr.dataset.sym}</td><td class="name">${tr.dataset.name}</td><td class="num fail" colspan="3">unavailable</td><td class="muted">—</td>`
}

function parseChart(sym, body) {
  const res = body.chart?.result?.[0]
  const meta = res?.meta
  if (!meta) throw new Error('empty')
  const price = meta.fulldayPrice ?? meta.regularMarketPrice
  const prev = meta.previousClose ?? meta.chartPreviousClose
  if (price == null || prev == null) throw new Error('missing')
  const chg = meta.fulldayChange ?? price - prev
  const pct = meta.fulldayChangePercent ?? (chg / prev) * 100
  return { sym, price, prev, chg, pct, ts: (meta.regularMarketTime ?? 0) * 1000 }
}

async function fetchChart(url, sym) {
  const r = await fetch('https://proxy.cors.dev/' + url)
  if (r.status === 429) return { sym, error: '429' }
  if (!r.ok) return { sym, error: String(r.status) }
  return parseChart(sym, await r.json())
}

async function fetchQuote(sym) {
  const targets = [
    `https://query1.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(sym)}?${CHART_QUERY}`,
    `https://query2.finance.yahoo.com/v8/finance/chart/${encodeURIComponent(sym)}?${CHART_QUERY}`,
  ]
  let error = 'unavailable'
  for (let attempt = 0; attempt < 2; attempt++) {
    for (const url of targets) {
      try {
        const quote = await fetchChart(url, sym)
        if (!quote.error) return quote
        error = quote.error
        if (quote.error !== '429') continue
      } catch (e) {
        error = e.message || 'unavailable'
      }
    }
    if (error !== '429') break
    await new Promise((resolve) => setTimeout(resolve, 600 * (attempt + 1)))
  }
  return { sym, error }
}

async function loadAll() {
  let cursor = 0
  async function worker() {
    while (cursor < ROWS.length) {
      const tr = ROWS[cursor++]
      const q = await fetchQuote(tr.dataset.sym)
      if (q.error) markUnavailable(tr)
      else paint(tr, q)
    }
  }
  const workers = Math.min(4, ROWS.length)
  await Promise.all(Array.from({ length: workers }, () => worker()))
}

function applyTick(raw) {
  const tr = ROWS.find((row) => row.dataset.sym === raw.sym)
  if (!tr || raw.price == null || Number.isNaN(raw.price)) return
  const stored = tr.dataset.prev
  const prev = stored != null && stored !== '' ? Number(stored) : null
  let chg = raw.chg
  let pct = raw.pct
  if (prev != null && Number.isFinite(prev) && prev !== 0) {
    chg = raw.price - prev
    pct = (chg / prev) * 100
  } else if (chg == null) {
    chg = raw.regChg
    pct = raw.regPct
  }
  if (chg == null || pct == null || Number.isNaN(chg) || Number.isNaN(pct)) return
  const knownPrev = prev != null && Number.isFinite(prev) ? prev : raw.price - chg
  paint(tr, { price: raw.price, prev: knownPrev, chg, pct, ts: raw.ts || Date.now() })
}

function subscribe() {
  if (!socket || socket.readyState !== 1) return
  socket.send(JSON.stringify({ subscribe: ROWS.map((tr) => tr.dataset.sym) }))
}

function stopStream() {
  streamOn = false
  clearTimeout(reconnectTimer)
  clearInterval(heartbeatTimer)
  if (!socket) return
  socket.onclose = null
  socket.close()
  socket = null
}

function startStream() {
  streamOn = true
  if (socket && socket.readyState <= 1) return
  socket = new WebSocket(STREAM_URL)
  socket.onopen = () => {
    subscribe()
    clearInterval(heartbeatTimer)
    heartbeatTimer = setInterval(subscribe, 15000)
  }
  socket.onmessage = (ev) => {
    try {
      const data = JSON.parse(ev.data)
      if (data.type !== 'pricing' || !data.message) return
      applyTick(decodePricing(data.message))
    } catch {
      // Ignore a malformed frame and keep the last good price.
    }
  }
  socket.onclose = () => {
    clearInterval(heartbeatTimer)
    socket = null
    if (!streamOn) return
    reconnectTimer = setTimeout(startStream, 2000)
  }
}

function applyFilters() {
  const q = filterInput.value.trim().toLowerCase()
  const group = chips.find((c) => c.classList.contains('active'))?.dataset.group ?? 'all'
  for (const tr of ROWS) {
    const matchGroup = group === 'all' || tr.dataset.group === group
    const matchText = !q || tr.dataset.sym.toLowerCase().includes(q) || tr.dataset.name.toLowerCase().includes(q)
    tr.hidden = !(matchGroup && matchText)
  }
}

filterInput.addEventListener('input', applyFilters)
for (const chip of chips) {
  chip.addEventListener('click', () => {
    for (const c of chips) c.classList.remove('active')
    chip.classList.add('active')
    applyFilters()
  })
}

streamBtn.addEventListener('click', () => {
  const on = streamBtn.getAttribute('aria-pressed') !== 'true'
  streamBtn.setAttribute('aria-pressed', on ? 'true' : 'false')
  streamBtn.classList.toggle('active', on)
  if (on) startStream()
  else stopStream()
})

startStream()
loadAll()
setInterval(loadAll, 60000)
</script>

<style>
  .page-head {
    margin-bottom: var(--space-2xl);
  }

  .toolbar {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .toolbar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  #filter {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    width: 100%;
    max-width: 28rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--bg);
    color: var(--fg);
  }

  #filter:focus {
    outline: none;
    border-color: var(--border-strong);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--fg-muted);
    cursor: pointer;
  }

  .chip:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .chip.active {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .table-wrap {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .stock-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .stock-table th,
  .stock-table td {
    padding: 0.45rem 0.6rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    vertical-align: top;
  }

  .stock-table th {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-faint);
    border-bottom: 2px solid var(--fg);
  }

  .stock-table tr:hover td {
    background: var(--bg-alt);
  }

  .ticker {
    font-family: var(--font-mono);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .name {
    color: var(--fg-muted);
  }

  .num {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: nowrap;
  }

  .ok {
    color: var(--c-ok);
  }

  .fail {
    color: var(--c-fail);
  }

  .muted {
    color: var(--fg-faint);
  }
</style>
