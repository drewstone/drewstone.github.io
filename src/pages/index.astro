---
import Base from '../layouts/Base.astro'
import { getCollection } from 'astro:content'
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order)
const originals = posts.filter(p => p.data.original)
---
<Base title="Drew Stone" description="Drew Stone. AI systems, mathematics, and computer science. Research results with proofs, counterexamples, and inspectable agent records." wide>
  <header class="introduction">
    <h1>Drew Stone</h1>
    <p>I build systems that let AI agents do sustained technical work.
      At <a href="https://tangle.tools">Tangle</a>, that means the infrastructure for agents to run experiments, share findings, and keep working.</p>
    <p>I write about mathematics, computer science, and what it takes to turn automated research into results we can check.</p>
    <p class="quiet"><a href="/about">More about me</a> · <a href="https://github.com/drewstone">Code</a></p>
  </header>
  <section>
    <h2><a href="/research">Proofs &amp; counterexamples</a></h2>
    <p class="section-intro">The statement, the witness, and the evidence behind it.
      Three witnesses below address two proposed inequalities.</p>
    <ol class="research-list">
      {research.map(item => <li><a href={`/research/${item.id}`}><strong>{item.data.title}</strong><span>{item.data.claim}</span></a></li>)}
    </ol>
  </section>
  <section>
    <h2>Essays</h2>
    <ul class="essay-list">{posts.slice(0, 8).map(post => <li><a href={`/posts/${post.id}`}>{post.data.title}</a><time>{post.data.date.toLocaleDateString('en-US', {month:'short',year:'numeric'})}</time></li>)}</ul>
    <p><a href="/posts">All essays</a></p>
  </section>
  <section class="authorship">
    <h2>Writing &amp; authorship</h2>
    <p>AI-assisted essays carry revision histories and captured writing sessions.
      My <a href="/experiment">authorship record</a> distinguishes those edits from supporting research.</p>
    <ul>{originals.map(post => <li><a href={`/posts/${post.id}`}>{post.data.title}</a> <span class="human">human original</span></li>)}</ul>
  </section>
</Base>
<style>
  .introduction { max-width: 39rem; margin-bottom: var(--space-2xl); }
  .introduction h1 { font-size: clamp(2.2rem, 6vw, 3rem); margin-bottom: 1.2rem; }
  .introduction p { font-size: 1.12rem; }
  .quiet, .section-intro { color: var(--fg-muted); }
  section { margin-bottom: var(--space-2xl); }
  h2 { font-size: 1.4rem; }
  .research-list { list-style: none; padding: 0; }
  .research-list li { border-bottom: 1px solid var(--border); }
  .research-list a { display: block; padding: 1.1rem 0; text-decoration: none; }
  .research-list a:hover, .essay-list li:hover { background: var(--bg-alt); }
  .research-list strong { display: block; font-size: 1.15rem; font-weight: 400; text-decoration: underline; }
  .research-list span { display: block; color: var(--fg-muted); margin-top: .25rem; font-size: .95rem; max-width: 42rem; }
  .essay-list { list-style: none; padding: 0; }
  .essay-list li { display: flex; justify-content: space-between; gap: 1rem; padding: .5rem 0; }
  time { white-space: nowrap; font: .7rem var(--font-mono); color: var(--fg-faint); padding-top: .4rem; }
  .authorship { max-width: 39rem; }
  .human { color: var(--c-human); font: .65rem var(--font-mono); }
</style>
