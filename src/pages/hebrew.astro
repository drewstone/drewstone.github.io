---
import Base from '../layouts/Base.astro'
import raw from '../data/hebrew.json'

interface Entry {
  word: string
  hebrewNiqqud?: string
  translit: string
  meaning: string
  example: string
  exampleNiqqud?: string
  exampleEn: string
  learned: string
  notes?: string
}

function requiredString(row: Record<string, unknown>, key: string, index: number) {
  const value = row[key]
  if (typeof value !== 'string' || value.trim() === '') {
    throw new Error(`src/data/hebrew.json[${index}].${key} must be a non-empty string`)
  }
  return value
}

function optionalString(row: Record<string, unknown>, key: string, index: number) {
  if (!(key in row) || row[key] == null) return undefined
  const value = row[key]
  if (typeof value !== 'string' || value.trim() === '') {
    throw new Error(`src/data/hebrew.json[${index}].${key} must be a non-empty string when present`)
  }
  return value
}

function load(data: unknown): Entry[] {
  if (!Array.isArray(data)) throw new Error('src/data/hebrew.json must be a JSON array')
  return data.map((item, index) => {
    if (!item || typeof item !== 'object' || Array.isArray(item)) {
      throw new Error(`src/data/hebrew.json[${index}] must be an object`)
    }
    const row = item as Record<string, unknown>
    const learned = requiredString(row, 'learned', index)
    if (!/^\d{4}-\d{2}-\d{2}$/.test(learned)) {
      throw new Error(`src/data/hebrew.json[${index}].learned must be YYYY-MM-DD`)
    }
    const notes = row.notes
    if (notes != null && (typeof notes !== 'string' || notes.trim() === '')) {
      throw new Error(`src/data/hebrew.json[${index}].notes must be a non-empty string when present`)
    }
    return {
      word: requiredString(row, 'word', index),
      hebrewNiqqud: optionalString(row, 'hebrewNiqqud', index),
      translit: requiredString(row, 'translit', index),
      meaning: requiredString(row, 'meaning', index),
      example: requiredString(row, 'example', index),
      exampleNiqqud: optionalString(row, 'exampleNiqqud', index),
      exampleEn: requiredString(row, 'exampleEn', index),
      learned,
      notes: typeof notes === 'string' ? notes : undefined,
    }
  })
}

const entries = load(raw)
const entriesJson = JSON.stringify(entries).replaceAll('<', '\\u003c')
const resumePath = 'github.com/drewstone/drewstone.github.io/blob/main/HEBREW_LEARNING.md'
const first = entries[0]
---

<Base title="Hebrew" description="Hebrew words.">
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@400;500;700&family=Noto+Serif+Hebrew:wght@400;500;700&display=swap"
  />
  <script is:inline>
    ;(function () {
      var mode = 'drive'
      var theme = 'dark'
      try {
        var saved = localStorage.getItem('hebrew-mode')
        if (saved === 'review' || saved === 'list' || saved === 'drive') mode = saved
        if (localStorage.getItem('hebrew-drive-theme') === 'light') theme = 'light'
      } catch (e) {}
      document.documentElement.setAttribute('data-hebrew-mode', mode)
      if (mode === 'drive') document.body.classList.add('hebrew-drive')
      if (theme === 'light') document.body.classList.add('hebrew-light')
    })()
  </script>

  <div class="hebrew-page">
    <div class="topbar">
      <div class="modes" role="tablist" aria-label="Mode">
        <button type="button" role="tab" data-mode="drive" aria-selected="true">Drive</button>
        <button type="button" role="tab" data-mode="review" aria-selected="false">Review</button>
        <button type="button" role="tab" data-mode="list" aria-selected="false">List</button>
      </div>
      <div class="tools">
        <button type="button" id="nikud-toggle" class="tool" aria-pressed="true">Nikud</button>
        <button type="button" id="drive-theme" class="tool theme-toggle" aria-pressed="true">Dark</button>
      </div>
    </div>

    <section class="drive-view" aria-label="Drive">
      <div class="phase-bar" aria-hidden="true"><i id="phase-fill"></i></div>
      <div class="drive-stage" id="drive-stage">
        {
          first && (
            <>
              <p class="drive-word" lang="he" dir="rtl">
                {first.hebrewNiqqud || first.word}
              </p>
              <p class="drive-trans" dir="ltr">
                {first.translit}
              </p>
            </>
          )
        }
      </div>
      <button type="button" class="edge prev" id="drive-prev" aria-label="Previous word">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 4.5 L7.5 12 L15 19.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <button type="button" class="edge next" id="drive-next" aria-label="Next word">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 4.5 L16.5 12 L9 19.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <div class="pause-mark" id="pause-mark" hidden aria-hidden="true"><span></span><span></span></div>
      <div class="dots" id="drive-dots" aria-label="Word progress"></div>
    </section>

    <section class="review-view" aria-label="Review">
      <div class="review-bar">
        <p class="due" id="due-count" aria-live="polite">0 due</p>
        <button type="button" id="flip-dir">א → A</button>
      </div>
      <button type="button" class="card" id="review-card" aria-expanded="false"></button>
      <div class="rates" id="rates" hidden>
        <button type="button" data-grade="again" aria-keyshortcuts="1"><b>1</b> Again</button>
        <button type="button" data-grade="hard" aria-keyshortcuts="2"><b>2</b> Hard</button>
        <button type="button" data-grade="good" aria-keyshortcuts="3"><b>3</b> Good</button>
        <button type="button" data-grade="easy" aria-keyshortcuts="4"><b>4</b> Easy</button>
      </div>
      <div class="review-empty" id="review-empty" hidden>
        <button type="button" id="study-anyway">study anyway</button>
      </div>
    </section>

    <section class="list-view" aria-label="List">
      <h1>Hebrew</h1>
      <div class="list-grid">
        {
          entries.map((entry) => (
            <button type="button" class="list-card" aria-expanded="false">
              <span class="list-word" lang="he" dir="rtl">
                {entry.hebrewNiqqud || entry.word}
              </span>
              <span class="list-gloss">
                <span class="list-trans">{entry.translit}</span>
                <span>{entry.meaning}</span>
              </span>
              <span class="list-sentence">
                <span class="he" lang="he" dir="rtl">
                  {entry.exampleNiqqud || entry.example}
                </span>
                <span class="en">{entry.exampleEn}</span>
              </span>
            </button>
          ))
        }
      </div>
      <p class="deck"><a href="/hebrew/hebrew.apkg">Anki deck</a></p>
      <p class="resume">
        Hebrew: resume from <a href={`https://${resumePath}`}>{resumePath}</a>
      </p>
    </section>
  </div>

  <script type="application/json" id="hebrew-entries" set:html={entriesJson}></script>
  <script is:inline>
    ;(function () {
      var PHASE_MS = 4500
      var DAY = 86400000
      var SRS_KEY = 'hebrew-srs'
      var MODE_KEY = 'hebrew-mode'
      var THEME_KEY = 'hebrew-drive-theme'
      var FRONT_KEY = 'hebrew-front'
      var NIKUD_KEY = 'hebrew-nikud'
      var CHROME_MS = 3800

      var entries = JSON.parse(document.getElementById('hebrew-entries').textContent || '[]')
      var stage = document.getElementById('drive-stage')
      var dots = document.getElementById('drive-dots')
      var fill = document.getElementById('phase-fill')
      var pauseMark = document.getElementById('pause-mark')
      var dueCount = document.getElementById('due-count')
      var reviewCard = document.getElementById('review-card')
      var rates = document.getElementById('rates')
      var reviewEmpty = document.getElementById('review-empty')
      var flipBtn = document.getElementById('flip-dir')
      var themeBtn = document.getElementById('drive-theme')
      var nikudBtn = document.getElementById('nikud-toggle')
      var topbar = document.querySelector('.topbar')
      var modeButtons = Array.prototype.slice.call(document.querySelectorAll('.modes button'))

      var srs = loadSrs()
      var frontDir = 'he'
      var nikudOn = true
      try {
        if (localStorage.getItem(FRONT_KEY) === 'en') frontDir = 'en'
        if (localStorage.getItem(NIKUD_KEY) === 'off') nikudOn = false
      } catch (e) {}

      var driveOrder = entries.slice()
      var index = 0
      var phase = 0
      var userPaused = false
      var driveLive = false
      var reviewLive = false
      var anyway = false
      var queue = []
      var revealed = false
      var timer = 0
      var fadeTimer = 0
      var barRaf = 0
      var phaseStart = 0
      var remaining = PHASE_MS
      var fitTimer = 0
      var chromeTimer = 0
      var chromeIdle = false

      function hebWord(entry) {
        return nikudOn && entry.hebrewNiqqud ? entry.hebrewNiqqud : entry.word
      }

      function hebExample(entry) {
        return nikudOn && entry.exampleNiqqud ? entry.exampleNiqqud : entry.example
      }

      function loadSrs() {
        try {
          var raw = JSON.parse(localStorage.getItem(SRS_KEY) || '{}')
          if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return {}
          return raw
        } catch (e) {
          return {}
        }
      }

      function saveSrs() {
        try {
          localStorage.setItem(SRS_KEY, JSON.stringify(srs))
        } catch (e) {}
      }

      function endOfToday(now) {
        var d = new Date(now)
        d.setHours(23, 59, 59, 999)
        return d.getTime()
      }

      function isDue(card, now) {
        if (!card || !card.due) return true
        return card.due <= endOfToday(now)
      }

      function dueEntries(now) {
        return entries.filter(function (entry) {
          return isDue(srs[entry.word], now)
        })
      }

      function schedule(prev, grade, now) {
        var ease = prev && typeof prev.ease === 'number' ? prev.ease : 2.5
        var interval = prev && typeof prev.interval === 'number' ? prev.interval : 0
        var reps = prev && typeof prev.reps === 'number' ? prev.reps : 0
        if (grade === 'again') {
          return {
            ease: Math.max(1.3, ease - 0.2),
            interval: 0,
            reps: 0,
            due: now + 10 * 60 * 1000,
            seen: now,
          }
        }
        var q = grade === 'hard' ? 3 : grade === 'easy' ? 5 : 4
        var nextEase = ease + (0.1 - (5 - q) * (0.08 + (5 - q) * 0.02))
        if (nextEase < 1.3) nextEase = 1.3
        var nextInterval
        if (grade === 'hard') nextInterval = reps === 0 ? 1 : Math.max(1, Math.round(interval * 12) / 10)
        else if (grade === 'easy') nextInterval = reps === 0 ? 4 : Math.max(1, Math.round(interval * ease * 1.3))
        else if (reps === 0) nextInterval = 1
        else if (reps === 1) nextInterval = 6
        else nextInterval = Math.max(1, Math.round(interval * ease))
        return {
          ease: nextEase,
          interval: nextInterval,
          reps: reps + 1,
          due: now + nextInterval * DAY,
          seen: now,
        }
      }

      function markSeen(word) {
        var prev = srs[word] || {}
        srs[word] = {
          ease: typeof prev.ease === 'number' ? prev.ease : 2.5,
          interval: typeof prev.interval === 'number' ? prev.interval : 0,
          reps: typeof prev.reps === 'number' ? prev.reps : 0,
          due: typeof prev.due === 'number' ? prev.due : 0,
          seen: Date.now(),
        }
        saveSrs()
      }

      function driveWeight(entry, now) {
        var card = srs[entry.word]
        var seen = card && card.seen ? card.seen : 0
        var age = seen ? Math.min(30, (now - seen) / DAY) : 30
        var weight = 1 + age
        if (isDue(card, now)) weight *= 5
        if (!seen) weight *= 1.5
        return weight
      }

      function weightedOrder(now) {
        return entries
          .map(function (entry) {
            var weight = driveWeight(entry, now)
            return { entry: entry, key: Math.random() ** (1 / weight) }
          })
          .sort(function (a, b) {
            return b.key - a.key
          })
          .map(function (item) {
            return item.entry
          })
      }

      var scopeName = ''
      var scopeValue = ''
      var scopeHost = document.querySelector('.hebrew-page')
      if (scopeHost) {
        for (var s = 0; s < scopeHost.attributes.length; s++) {
          var attr = scopeHost.attributes[s]
          if (attr.name.indexOf('data-astro-cid') === 0) {
            scopeName = attr.name
            scopeValue = attr.value
            break
          }
        }
      }

      function el(tag, cls, text, attrs) {
        var node = document.createElement(tag)
        if (scopeName) node.setAttribute(scopeName, scopeValue)
        if (cls) node.className = cls
        if (text != null) node.textContent = text
        if (attrs) {
          Object.keys(attrs).forEach(function (key) {
            node.setAttribute(key, attrs[key])
          })
        }
        return node
      }

      function renderDrive() {
        var entry = driveOrder[index]
        if (!entry) {
          stage.replaceChildren()
          return
        }
        stage.replaceChildren()
        if (phase === 0) {
          stage.append(
            el('p', 'drive-word', hebWord(entry), { lang: 'he', dir: 'rtl' }),
            el('p', 'drive-trans', entry.translit, { dir: 'ltr' }),
          )
        } else if (phase === 1) {
          stage.append(el('p', 'drive-example', hebExample(entry), { lang: 'he', dir: 'rtl' }))
        } else {
          stage.append(
            el('p', 'drive-meaning', entry.meaning, { dir: 'ltr' }),
            el('p', 'drive-en', entry.exampleEn, { dir: 'ltr' }),
          )
        }
        dots.replaceChildren()
        driveOrder.forEach(function (_, i) {
          var dot = document.createElement('i')
          if (scopeName) dot.setAttribute(scopeName, scopeValue)
          if (i === index) dot.className = 'on'
          dots.append(dot)
        })
        dots.setAttribute('aria-label', 'Word ' + (index + 1) + ' of ' + driveOrder.length)
      }

      function fadeThen(fn) {
        clearTimeout(fadeTimer)
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          fn()
          return
        }
        stage.classList.add('is-fading')
        fadeTimer = setTimeout(function () {
          fn()
          void stage.offsetWidth
          stage.classList.remove('is-fading')
        }, 280)
      }

      function tick() {
        cancelAnimationFrame(barRaf)
        var p = Math.min(1, (performance.now() - phaseStart) / PHASE_MS)
        fill.style.transform = 'scaleX(' + p + ')'
        if (!userPaused && document.documentElement.dataset.hebrewMode === 'drive') {
          barRaf = requestAnimationFrame(tick)
        }
      }

      function arm(ms) {
        clearTimeout(timer)
        phaseStart = performance.now() - (PHASE_MS - ms)
        remaining = ms
        timer = setTimeout(advance, ms)
        tick()
      }

      function haltTimer() {
        clearTimeout(timer)
        cancelAnimationFrame(barRaf)
        remaining = Math.max(0, PHASE_MS - (performance.now() - phaseStart))
      }

      function paintPause() {
        pauseMark.hidden = !userPaused
        stage.classList.toggle('is-paused', userPaused)
      }

      function present(fade) {
        clearTimeout(timer)
        cancelAnimationFrame(barRaf)
        var apply = function () {
          renderDrive()
          if (phase === 0 && driveOrder[index]) markSeen(driveOrder[index].word)
          paintPause()
          if (!userPaused) arm(PHASE_MS)
          else {
            remaining = PHASE_MS
            fill.style.transform = 'scaleX(0)'
          }
        }
        if (fade) fadeThen(apply)
        else apply()
      }

      function advance() {
        if (!driveOrder.length) return
        if (phase < 2) phase += 1
        else {
          phase = 0
          index = (index + 1) % driveOrder.length
        }
        present(true)
      }

      function go(delta) {
        if (!driveOrder.length) return
        index = (index + delta + driveOrder.length) % driveOrder.length
        phase = 0
        present(true)
      }

      function togglePause() {
        userPaused = !userPaused
        paintPause()
        if (userPaused) haltTimer()
        else arm(remaining > 0 ? remaining : PHASE_MS)
      }

      function startDrive() {
        srs = loadSrs()
        driveOrder = entries.length ? weightedOrder(Date.now()) : []
        index = 0
        phase = 0
        userPaused = false
        driveLive = true
        present(false)
      }

      function stopDrive() {
        driveLive = false
        clearTimeout(timer)
        clearTimeout(fadeTimer)
        clearTimeout(chromeTimer)
        cancelAnimationFrame(barRaf)
        stage.classList.remove('is-fading')
        showChrome()
      }

      function paintDue() {
        dueCount.textContent = dueEntries(Date.now()).length + ' due'
      }

      function paintFlip() {
        var he = frontDir !== 'en'
        flipBtn.textContent = he ? 'א → A' : 'A → א'
        flipBtn.setAttribute('aria-label', he ? 'Front is Hebrew. Flip to English.' : 'Front is English. Flip to Hebrew.')
      }

      function showEmpty() {
        reviewCard.hidden = true
        rates.hidden = true
        reviewEmpty.hidden = false
        revealed = false
        paintDue()
      }

      function showCard() {
        var entry = queue[0]
        if (!entry) {
          anyway = false
          showEmpty()
          return
        }
        reviewEmpty.hidden = true
        reviewCard.hidden = false
        rates.hidden = !revealed
        reviewCard.setAttribute('aria-expanded', revealed ? 'true' : 'false')
        reviewCard.replaceChildren()
        if (frontDir === 'en') {
          reviewCard.append(el('span', 'review-front-en', entry.meaning, { dir: 'ltr' }))
        } else {
          reviewCard.append(el('span', 'review-he', hebWord(entry), { lang: 'he', dir: 'rtl' }))
        }
        if (!revealed) return
        var back = el('span', 'review-back')
        if (frontDir === 'en') back.append(el('span', 'review-he answer', hebWord(entry), { lang: 'he', dir: 'rtl' }))
        back.append(el('span', 'review-trans', entry.translit, { dir: 'ltr' }))
        if (frontDir !== 'en') back.append(el('span', 'review-meaning', entry.meaning, { dir: 'ltr' }))
        back.append(el('span', 'review-ex', hebExample(entry), { lang: 'he', dir: 'rtl' }))
        back.append(el('span', 'review-ex-en', entry.exampleEn, { dir: 'ltr' }))
        reviewCard.append(back)
      }

      function openReview() {
        srs = loadSrs()
        anyway = false
        reviewLive = true
        revealed = false
        paintFlip()
        var due = dueEntries(Date.now())
        paintDue()
        if (!due.length) {
          queue = []
          showEmpty()
          return
        }
        queue = due.slice().sort(function (a, b) {
          var da = (srs[a.word] && srs[a.word].due) || 0
          var db = (srs[b.word] && srs[b.word].due) || 0
          var sa = (srs[a.word] && srs[a.word].seen) || 0
          var sb = (srs[b.word] && srs[b.word].seen) || 0
          return da - db || sa - sb
        })
        showCard()
      }

      function studyAnyway() {
        srs = loadSrs()
        anyway = true
        revealed = false
        queue = entries.slice().sort(function (a, b) {
          var da = (srs[a.word] && srs[a.word].due) || 0
          var db = (srs[b.word] && srs[b.word].due) || 0
          var sa = (srs[a.word] && srs[a.word].seen) || 0
          var sb = (srs[b.word] && srs[b.word].seen) || 0
          return da - db || sa - sb
        })
        showCard()
      }

      function reveal() {
        if (revealed || !queue.length || reviewCard.hidden) return
        revealed = true
        showCard()
      }

      function rate(grade) {
        if (!revealed || !queue.length) return
        var entry = queue.shift()
        var now = Date.now()
        srs[entry.word] = schedule(srs[entry.word], grade, now)
        saveSrs()
        if (grade === 'again') queue.splice(Math.min(queue.length, 2), 0, entry)
        revealed = false
        paintDue()
        if (!queue.length) {
          anyway = false
          showEmpty()
          return
        }
        showCard()
      }

      function paintTheme() {
        var light = document.body.classList.contains('hebrew-light')
        themeBtn.textContent = light ? 'Light' : 'Dark'
        themeBtn.setAttribute('aria-pressed', light ? 'false' : 'true')
        themeBtn.setAttribute('aria-label', light ? 'Light background. Switch to dark.' : 'Dark background. Switch to light.')
      }

      function applyListNikud() {
        var cards = document.querySelectorAll('.list-card')
        Array.prototype.forEach.call(cards, function (card, i) {
          var entry = entries[i]
          if (!entry) return
          var word = card.querySelector('.list-word')
          var example = card.querySelector('.list-sentence .he')
          if (word) word.textContent = hebWord(entry)
          if (example) example.textContent = hebExample(entry)
        })
      }

      function paintNikud() {
        nikudBtn.setAttribute('aria-pressed', nikudOn ? 'true' : 'false')
        nikudBtn.setAttribute('aria-label', nikudOn ? 'Vowels on. Hide vowels.' : 'Vowels off. Show vowels.')
        applyListNikud()
        if (document.documentElement.dataset.hebrewMode === 'drive' && driveOrder.length) renderDrive()
        if (document.documentElement.dataset.hebrewMode === 'review' && queue.length && !reviewCard.hidden) showCard()
      }

      function showChrome() {
        chromeIdle = false
        topbar.classList.remove('is-idle')
      }

      function armChrome() {
        clearTimeout(chromeTimer)
        showChrome()
        if (document.documentElement.dataset.hebrewMode !== 'drive' || userPaused) return
        chromeTimer = setTimeout(function () {
          if (document.documentElement.dataset.hebrewMode !== 'drive' || userPaused) return
          chromeIdle = true
          topbar.classList.add('is-idle')
        }, CHROME_MS)
      }

      function paintModes(mode) {
        modeButtons.forEach(function (btn) {
          var on = btn.dataset.mode === mode
          btn.setAttribute('aria-selected', on ? 'true' : 'false')
          btn.tabIndex = on ? 0 : -1
        })
      }

      function fitList() {
        var grid = document.querySelector('.list-grid')
        if (!grid || document.documentElement.dataset.hebrewMode !== 'list') return
        grid.style.height = ''
      }

      function setMode(mode) {
        var same = document.documentElement.dataset.hebrewMode === mode
        if (mode !== 'drive' && mode !== 'review' && mode !== 'list') mode = 'drive'
        document.documentElement.dataset.hebrewMode = mode
        document.body.classList.toggle('hebrew-drive', mode === 'drive')
        paintModes(mode)
        try {
          localStorage.setItem(MODE_KEY, mode)
        } catch (e) {}
        if (mode === 'drive') {
          if (!same || !driveLive) startDrive()
          armChrome()
        } else if (driveLive) stopDrive()
        if (mode !== 'drive') {
          clearTimeout(chromeTimer)
          showChrome()
        }
        if (mode === 'review') {
          if (!same || !reviewLive) openReview()
        } else reviewLive = false
        if (mode === 'list') requestAnimationFrame(fitList)
      }

      modeButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          setMode(btn.dataset.mode)
        })
      })

      themeBtn.addEventListener('click', function () {
        document.body.classList.toggle('hebrew-light')
        var light = document.body.classList.contains('hebrew-light')
        try {
          localStorage.setItem(THEME_KEY, light ? 'light' : 'dark')
        } catch (e) {}
        paintTheme()
        armChrome()
      })

      nikudBtn.addEventListener('click', function () {
        nikudOn = !nikudOn
        try {
          localStorage.setItem(NIKUD_KEY, nikudOn ? 'on' : 'off')
        } catch (e) {}
        paintNikud()
        armChrome()
      })

      document.getElementById('drive-prev').addEventListener('click', function () {
        go(-1)
      })
      document.getElementById('drive-next').addEventListener('click', function () {
        go(1)
      })
      document.querySelector('.drive-view').addEventListener('click', function (event) {
        if (event.target.closest('button, a')) {
          armChrome()
          return
        }
        if (chromeIdle) {
          armChrome()
          return
        }
        togglePause()
        if (userPaused) {
          clearTimeout(chromeTimer)
          showChrome()
        } else armChrome()
      })

      reviewCard.addEventListener('click', function () {
        if (!revealed) reveal()
      })
      rates.addEventListener('click', function (event) {
        var btn = event.target.closest('[data-grade]')
        if (btn) rate(btn.dataset.grade)
      })
      document.getElementById('study-anyway').addEventListener('click', studyAnyway)
      flipBtn.addEventListener('click', function () {
        frontDir = frontDir === 'en' ? 'he' : 'en'
        try {
          localStorage.setItem(FRONT_KEY, frontDir)
        } catch (e) {}
        paintFlip()
        if (queue.length) showCard()
      })

      document.querySelector('.list-grid').addEventListener('click', function (event) {
        var card = event.target.closest('.list-card')
        if (!card) return
        var open = card.classList.toggle('is-open')
        card.setAttribute('aria-expanded', open ? 'true' : 'false')
        if (!open) return
        Array.prototype.forEach.call(document.querySelectorAll('.list-card.is-open'), function (other) {
          if (other === card) return
          other.classList.remove('is-open')
          other.setAttribute('aria-expanded', 'false')
        })
      })

      window.addEventListener('keydown', function (event) {
        var mode = document.documentElement.dataset.hebrewMode
        if (mode === 'drive') {
          if (event.key === 'ArrowRight') {
            event.preventDefault()
            go(1)
            armChrome()
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault()
            go(-1)
            armChrome()
          } else if (event.key === ' ' && !event.target.closest('button, a')) {
            event.preventDefault()
            if (chromeIdle) armChrome()
            else {
              togglePause()
              if (userPaused) {
                clearTimeout(chromeTimer)
                showChrome()
              } else armChrome()
            }
          }
          return
        }
        if (mode !== 'review') return
        if ((event.key === ' ' || event.key === 'Enter') && !event.target.closest('button, a')) {
          event.preventDefault()
          reveal()
          return
        }
        var grades = { '1': 'again', '2': 'hard', '3': 'good', '4': 'easy' }
        if (grades[event.key]) {
          event.preventDefault()
          rate(grades[event.key])
        }
      })

      document.addEventListener('visibilitychange', function () {
        if (document.documentElement.dataset.hebrewMode !== 'drive' || !driveLive) return
        if (document.hidden) haltTimer()
        else if (!userPaused) arm(remaining > 0 ? remaining : PHASE_MS)
      })

      window.addEventListener('resize', function () {
        clearTimeout(fitTimer)
        fitTimer = setTimeout(fitList, 120)
      })

      paintTheme()
      paintNikud()
      paintFlip()
      setMode(document.documentElement.dataset.hebrewMode || 'drive')
    })()
  </script>
